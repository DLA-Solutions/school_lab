# Copy to .env when the mobile app is initialized.
#
#   cp .env.example .env

# API base URL (local development — Rails on the host). Must be prefixed with
# EXPO_PUBLIC_ so Expo exposes it to the app bundle.
# - iOS Simulator: reaches the Mac's localhost directly.
# - Android emulator: replace localhost with 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
