#!/usr/bin/env bash
#
# Local backend CI — mirrors the web/ jobs in .github/workflows/ci.yml:
#   lint, scan_ruby (brakeman + bundler-audit), test (+ OpenAPI drift), production image.
#
# Run from anywhere:
#   web/bin/backend-ci
#
# On success, writes .cursor/backend-ci.stamp with the current HEAD SHA so PR creation
# hooks can verify CI ran on the commit being opened.

set -uo pipefail

WEB_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$WEB_ROOT/.." && pwd)"
STAMP_FILE="$REPO_ROOT/.cursor/backend-ci.stamp"

cd "$WEB_ROOT"

failures=0
step_num=0

section() {
  printf '\n\033[1m[%s] %s\033[0m\n' "$1" "$2"
}

run_step() {
  local name="$1"
  shift
  step_num=$((step_num + 1))
  section "$step_num" "$name"
  if "$@"; then
    printf '  \033[32mok\033[0m\n'
  else
    printf '  \033[31mFAILED\033[0m\n'
    failures=$((failures + 1))
  fi
}

ensure_postgres() {
  if RAILS_ENV=test bin/rails runner 'ActiveRecord::Base.connection_pool.checkout' >/dev/null 2>&1; then
    return 0
  fi

  printf '  PostgreSQL not reachable — starting docker compose services...\n'
  if [ -f "$REPO_ROOT/Makefile" ]; then
    make -C "$REPO_ROOT" services-up
    sleep 3
  fi

  RAILS_ENV=test bin/rails runner 'ActiveRecord::Base.connection_pool.checkout' >/dev/null 2>&1
}

export RAILS_ENV=test
export POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
export POSTGRES_PORT="${POSTGRES_PORT:-5432}"
export POSTGRES_USER="${POSTGRES_USER:-school_lab}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-school_lab}"

printf '\033[1mBackend CI\033[0m (web/ — matches .github/workflows/ci.yml backend jobs)\n'

run_step "Lint (RuboCop)" bin/rubocop -f github
run_step "Security scan (Brakeman)" bin/brakeman --no-pager --exit-on-error
run_step "Security scan (Bundler audit)" bin/bundler-audit

section "—" "Test suite (requires PostgreSQL)"
if ensure_postgres; then
  run_step "Prepare test database" bin/rails db:test:prepare
  run_step "RSpec" bundle exec rspec
  run_step "Regenerate OpenAPI" bundle exec rake swagger:build
  run_step "OpenAPI drift check" git diff --exit-code swagger/v1/swagger.yaml
else
  printf '  \033[31mFAILED\033[0m — PostgreSQL unavailable. Run: make services-up\n'
  failures=$((failures + 1))
fi

section "—" "Production image"
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  run_step "Docker build (production)" docker build -q .
else
  printf '  \033[31mFAILED\033[0m — Docker not running. Start Docker Desktop and re-run.\n'
  failures=$((failures + 1))
fi

printf '\n\033[1mResult\033[0m\n'
if [ "$failures" -gt 0 ]; then
  printf '  \033[31m%d step(s) failed.\033[0m Fix issues and re-run: web/bin/backend-ci\n\n' "$failures"
  rm -f "$STAMP_FILE"
  exit 1
fi

mkdir -p "$(dirname "$STAMP_FILE")"
git -C "$REPO_ROOT" rev-parse HEAD > "$STAMP_FILE"
printf '  \033[32mAll backend CI checks passed.\033[0m Stamp: %s\n\n' "$STAMP_FILE"
exit 0
