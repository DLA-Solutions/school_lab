#!/usr/bin/env bash
#
# Local backend CI — mirrors the web/ jobs in .github/workflows/ci.yml:
#   lint, scan_ruby (brakeman + bundler-audit), test (+ OpenAPI drift), optional production image.
#
# Prefer repo-root bin/ci for monorepo path filters (web + SPAs). Use this script for web/ only.
#
# Run from anywhere:
#   web/bin/backend-ci              # default: fast scoped lint/tests + OpenAPI when needed
#   web/bin/backend-ci --full       # full gate (RuboCop all, Brakeman, bundler-audit, all RSpec)
#   web/bin/backend-ci --fast       # same as default; CI_FULL=1 enables --full
#   web/bin/backend-ci --skip-docker
#   web/bin/backend-ci --docker     # force production image build
#   web/bin/backend-ci-fast         # same as --fast
#
# On success, writes .cursor/backend-ci.stamp and .cursor/ci.stamp (optional bookkeeping).
#
# Default fast mode skips Docker and security scans; narrows lint/tests vs --base.
# Falls back to full RSpec when Gemfile, migrations, schema, or Dockerfile change.
# Use --full or CI_FULL=1 for the complete merge gate.

set -uo pipefail

WEB_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$WEB_ROOT/.." && pwd)"
STAMP_FILE="$REPO_ROOT/.cursor/backend-ci.stamp"

FAST_MODE=1
FULL_EXPLICIT=0
FAST_EXPLICIT=0
SKIP_DOCKER=1
FORCE_DOCKER=0
BASE_REF="origin/main"

usage() {
  cat <<'EOF'
Usage: web/bin/backend-ci [OPTIONS]

  (no flags)       Fast backend CI — scoped RuboCop/RSpec; OpenAPI when contract files change.
  --full           Full backend CI — same jobs as archived GitHub workflow. CI_FULL=1 same.
  --fast           Explicit fast path (default).
  --skip-docker    Full lint/tests/OpenAPI; skip production image build.
  --docker         Build production image even when Dockerfile/Gemfile unchanged.
  --base REF       Merge base for --fast change detection (default: origin/main).
  -h, --help       Show this help.

Fast mode skips Brakeman, bundler-audit, and Docker. Use --full or CI_FULL=1 before merge.
EOF
}

if [ "${CI_FULL:-0}" = "1" ]; then
  FAST_MODE=0
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --full)
      FULL_EXPLICIT=1
      FAST_MODE=0
      SKIP_DOCKER=0
      ;;
    --fast)
      FAST_EXPLICIT=1
      FAST_MODE=1
      SKIP_DOCKER=1
      ;;
    --skip-docker)
      FULL_EXPLICIT=1
      FAST_MODE=0
      SKIP_DOCKER=1
      ;;
    --docker)
      FORCE_DOCKER=1
      SKIP_DOCKER=0
      ;;
    --base)
      shift
      BASE_REF="${1:?--base requires a ref}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [ "$FAST_EXPLICIT" -eq 1 ]; then
  FAST_MODE=1
  SKIP_DOCKER=1
elif [ "$FULL_EXPLICIT" -eq 1 ]; then
  FAST_MODE=0
elif [ "${CI_FULL:-0}" = "1" ]; then
  FAST_MODE=0
  SKIP_DOCKER=0
fi


cd "$WEB_ROOT"

failures=0
step_num=0

section() {
  printf '\n\033[1m[%s] %s\033[0m\n' "$1" "$2"
}

run_step() {
  local name="$1"
  shift
  step_num=$((step_num + 1))
  section "$step_num" "$name"
  if "$@"; then
    printf '  \033[32mok\033[0m\n'
  else
    printf '  \033[31mFAILED\033[0m\n'
    failures=$((failures + 1))
  fi
}

run_step_skip() {
  local name="$1"
  step_num=$((step_num + 1))
  section "$step_num" "$name"
  printf '  \033[33mskipped\033[0m\n'
}

ensure_postgres() {
  if RAILS_ENV=test bin/rails runner 'ActiveRecord::Base.connection_pool.checkout' >/dev/null 2>&1; then
    return 0
  fi

  printf '  PostgreSQL not reachable — starting docker compose services...\n'
  if [ -f "$REPO_ROOT/Makefile" ]; then
    make -C "$REPO_ROOT" services-up
    sleep 3
  fi

  RAILS_ENV=test bin/rails runner 'ActiveRecord::Base.connection_pool.checkout' >/dev/null 2>&1
}

resolve_base_ref() {
  if git -C "$REPO_ROOT" rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
    printf '%s' "$BASE_REF"
    return 0
  fi

  if git -C "$REPO_ROOT" rev-parse --verify "${BASE_REF#origin/}" >/dev/null 2>&1; then
    printf '%s' "${BASE_REF#origin/}"
    return 0
  fi

  git -C "$REPO_ROOT" merge-base HEAD origin/main 2>/dev/null || git -C "$REPO_ROOT" rev-parse HEAD~1
}

collect_changed_web_files() {
  local base
  base="$(resolve_base_ref)"
  git -C "$REPO_ROOT" diff --name-only "$base"...HEAD -- web/ 2>/dev/null || true
}


requires_full_rubocop() {
  local changed="$1"
  printf '%s\n' "$changed" | grep -qE '^web/(\.rubocop|Gemfile$)'
}

requires_full_test_suite() {
  local changed="$1"
  printf '%s\n' "$changed" | grep -qE '^web/(Gemfile$|Dockerfile|db/(migrate/|schema\.rb))'
}

requires_openapi_check() {
  local changed="$1"
  if [ "$FAST_MODE" -eq 0 ]; then
    return 0
  fi

  printf '%s\n' "$changed" | grep -qE '^web/(spec/requests/|swagger/|config/routes\.rb|app/controllers/)'
}

requires_docker_build() {
  local changed="$1"
  if [ "$FORCE_DOCKER" -eq 1 ]; then
    return 0
  fi

  if [ "$SKIP_DOCKER" -eq 1 ]; then
    return 1
  fi

  printf '%s\n' "$changed" | grep -qE '^web/(Dockerfile|Gemfile(\.lock)?|\.ruby-version|config/environments/production\.rb|bin/docker-entrypoint)'
}

collect_rubocop_targets() {
  local changed="$1"
  local file

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    case "$file" in
      web/*.rb)
        printf '%s\n' "${file#web/}"
        ;;
    esac
  done <<EOF
$changed
EOF
}

rspec_specs=""
rspec_spec_count=0

add_rspec_target() {
  local spec="$1"
  local existing

  [ -n "$spec" ] || return 0
  [ -f "$WEB_ROOT/$spec" ] || return 0

  for existing in $rspec_specs; do
    [ "$existing" = "$spec" ] && return 0
  done

  rspec_specs="$rspec_specs $spec"
  rspec_spec_count=$((rspec_spec_count + 1))
}

collect_rspec_targets() {
  local changed="$1"
  local file rel

  rspec_specs=""
  rspec_spec_count=0

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    case "$file" in
      web/spec/*_spec.rb)
        add_rspec_target "${file#web/}"
        ;;
      web/app/models/* | web/app/policies/* | web/app/services/* | web/app/serializers/* | web/app/blueprints/*)
        rel="${file#web/app/}"
        add_rspec_target "spec/${rel%.rb}_spec.rb"
        ;;
      web/app/controllers/*)
        rel="${file#web/app/}"
        add_rspec_target "spec/requests/${rel%.rb}_spec.rb"
        add_rspec_target "spec/${rel%.rb}_spec.rb"
        ;;
    esac
  done <<EOF
$changed
EOF

  if [ "$rspec_spec_count" -eq 0 ]; then
    return 1
  fi

  printf '%s\n' $rspec_specs
}

export RAILS_ENV=test
export POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
export POSTGRES_PORT="${POSTGRES_PORT:-5432}"
export POSTGRES_USER="${POSTGRES_USER:-school_lab}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-school_lab}"
export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-$WEB_ROOT/tmp/rubocop}"

if [ "$FAST_MODE" -eq 1 ]; then
  printf '\033[1mBackend CI (fast)\033[0m — scoped RuboCop/RSpec; OpenAPI when needed; Docker/security skipped\n'
else
  printf '\033[1mBackend CI (full)\033[0m — matches archived .github/workflows/ci.yml backend jobs\n'
fi

CHANGED_FILES="$(collect_changed_web_files)"

if [ "$FAST_MODE" -eq 1 ]; then
  if requires_full_rubocop "$CHANGED_FILES"; then
    run_step "Lint (RuboCop)" bin/rubocop -f github
  else
    RUBOCOP_TARGETS="$(collect_rubocop_targets "$CHANGED_FILES" || true)"
    if [ -z "${RUBOCOP_TARGETS// }" ]; then
      run_step_skip "Lint (RuboCop) — no changed web/*.rb vs $BASE_REF"
    else
      # shellcheck disable=SC2086
      run_step "Lint (RuboCop, changed files)" bin/rubocop -f github --force-exclusion $RUBOCOP_TARGETS
    fi
  fi
else
  run_step "Lint (RuboCop)" bin/rubocop -f github
fi

if [ "$FAST_MODE" -eq 1 ]; then
  run_step_skip "Security scan (Brakeman) — use --full or CI_FULL=1"
  run_step_skip "Security scan (Bundler audit) — use --full or CI_FULL=1"
else
  run_step "Security scan (Brakeman)" bin/brakeman --no-pager --exit-on-error
  run_step "Security scan (Bundler audit)" bin/bundler-audit
fi

section "—" "Test suite (requires PostgreSQL)"
if ensure_postgres; then
  run_step "Prepare test database" bin/rails db:test:prepare

  if requires_full_test_suite "$CHANGED_FILES"; then
    [ "$FAST_MODE" -eq 1 ] && printf '  \033[33mGemfile/migration/schema/Dockerfile changed — running full RSpec suite\033[0m\n'
    run_step "RSpec" bundle exec rspec
  elif [ "$FAST_MODE" -eq 1 ]; then
    RSPEC_TARGETS="$(collect_rspec_targets "$CHANGED_FILES" || true)"
    if [ -z "$RSPEC_TARGETS" ]; then
      run_step_skip "RSpec (no mapped specs for changed files)"
    else
      printf '  \033[33mRunning scoped specs: %s\033[0m\n' "$RSPEC_TARGETS"
      # shellcheck disable=SC2086
      run_step "RSpec (changed files)" bundle exec rspec $RSPEC_TARGETS
    fi
  else
    run_step "RSpec" bundle exec rspec
  fi

  if requires_openapi_check "$CHANGED_FILES"; then
    run_step "Regenerate OpenAPI" bundle exec rake swagger:build
    run_step "OpenAPI drift check" git diff --exit-code swagger/v1/swagger.yaml
  else
    run_step_skip "Regenerate OpenAPI (no API contract files changed)"
    run_step_skip "OpenAPI drift check (no API contract files changed)"
  fi
else
  printf '  \033[31mFAILED\033[0m — PostgreSQL unavailable. Run: make services-up\n'
  failures=$((failures + 1))
fi

section "—" "Production image"
if requires_docker_build "$CHANGED_FILES"; then
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    run_step "Docker build (production)" docker build -q .
  else
    printf '  \033[31mFAILED\033[0m — Docker not running. Start Docker Desktop, or re-run with --skip-docker / --fast.\n'
    failures=$((failures + 1))
  fi
else
  run_step_skip "Docker build (production) — unchanged in diff vs $BASE_REF"
fi

printf '\n\033[1mResult\033[0m\n'
if [ "$failures" -gt 0 ]; then
  printf '  \033[31m%d step(s) failed.\033[0m Fix issues and re-run: web/bin/backend-ci\n\n' "$failures"
  rm -f "$STAMP_FILE"
  exit 1
fi

mkdir -p "$(dirname "$STAMP_FILE")"
HEAD_SHA="$(git -C "$REPO_ROOT" rev-parse HEAD)"
printf '%s\n' "$HEAD_SHA" > "$STAMP_FILE"
if [ "$FAST_MODE" -eq 1 ]; then
  printf 'mode=fast\n' >> "$STAMP_FILE"
fi

CI_STAMP_FILE="$REPO_ROOT/.cursor/ci.stamp"
printf '%s\n' "$HEAD_SHA" > "$CI_STAMP_FILE"
printf 'surfaces=web\n' >> "$CI_STAMP_FILE"
[ "$FAST_MODE" -eq 1 ] && printf 'mode=fast\n' >> "$CI_STAMP_FILE"

printf '  \033[32mAll backend CI checks passed.\033[0m Stamp: %s\n\n' "$STAMP_FILE"
exit 0
