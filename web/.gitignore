# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/vendor/bundle

.env
.env.*
!.env.example

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/storage/*
!/storage/.keep

/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

/config/master.key
/config/credentials/*.key

# Client certificates and private keys (Cora / PSP integration)
*.pem
*.key
.certs/

/node_modules
