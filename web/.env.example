# Copy to .env — used by the Rails app and by docker compose (via Makefile).
#
#   cp .env.example .env

# PostgreSQL (Docker Compose at repo root)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=school_lab
POSTGRES_PASSWORD=school_lab
POSTGRES_DB=school_lab_development

# Redis — available locally; MVP cache uses Solid Cache on PostgreSQL.
# Switch config.cache_store to :redis_cache_store when scaling (see docs/web-stack.md).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Solid Queue inside Puma (optional — uncomment to process jobs in development).
# SOLID_QUEUE_IN_PUMA=1

# Spedy NFS-e integration (sandbox — set per deploy target).
SPEDY_API_BASE_URL=https://api.spedy.com.br
SPEDY_PLATFORM_API_KEY=
SPEDY_WEBHOOK_TOKEN=

# Cora Direct Integration (sandbox — same URLs as staging deploy). Both hosts are the mTLS
# ones: the plain api.cora.com.br gateway rejects the client certificate with 401 access_denied.
CORA_API_BASE_URL=https://matls-clients.api.stage.cora.com.br
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token

# Autentique (e-signature). Registered per school with:
#   AUTENTIQUE_API_TOKEN=... bin/rails signature:register[SCHOOL_ID]
# Stored encrypted on school_signature_providers; never commit a real token.
AUTENTIQUE_API_TOKEN=
# Optional: reuse a webhook secret instead of generating one on register.
AUTENTIQUE_WEBHOOK_SECRET=

# Names the seeded school and its group, so a deployment does not carry a demo name into the UI.
SEED_SCHOOL_NAME=
SEED_SCHOOL_GROUP_NAME=
# Populate demo tenant (50–100 students, all actor types). Auto on local; set true on staging.
SEED_DEMO_DATA=
# Target student count when demo seed runs (clamped to 50–100).
SEED_STUDENT_COUNT=75

# Transactional e-mail (Postmark) — staging/production only. Local development uses Letter
# Opener at /letter_opener and does not need this token.
POSTMARK_API_TOKEN=
MAIL_FROM=contato@scholarpremium.com.br
# Optional override for invite links in development (defaults to http://localhost:5173 locally).
# SCHOOL_SPA_URL=http://localhost:5173
