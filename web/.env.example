# Copy to .env — used by the Rails app and by docker compose (via Makefile).
#
#   cp .env.example .env

# PostgreSQL (Docker Compose at repo root)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=school_lab
POSTGRES_PASSWORD=school_lab
POSTGRES_DB=school_lab_development

# Redis — available locally; MVP cache uses Solid Cache on PostgreSQL.
# Switch config.cache_store to :redis_cache_store when scaling (see docs/web-stack.md).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Solid Queue inside Puma (optional — uncomment to process jobs in development).
# SOLID_QUEUE_IN_PUMA=1
