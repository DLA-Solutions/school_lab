# Copy to .kamal/secrets.production. Read after .kamal/secrets-common.
# PostgreSQL and Redis run natively on the database VPS (10.0.0.3), outside Kamal.
#
# Required on the deploy machine:
#   JWT_SECRET_KEY_PRODUCTION  API token signing key (bin/rails secret)
#   POSTGRES_PASSWORD              password for the scholarpremium PostgreSQL role
#   REDIS_PASSWORD                 requirepass value of the Redis instance
#   POSTMARK_API_TOKEN_PRODUCTION  Postmark Server API token for transactional e-mail
#   GOOGLE_OAUTH_CLIENT_ID         OAuth Web client ID (must match SPA build secret)
#
# URL-encode the two passwords: characters such as @ : / ? # break the URL silently.

# Distinct per destination: staging shares this credentials file, so without separate keys a
# staging token would authenticate against production, where that user id is somebody else.
JWT_SECRET_KEY=$JWT_SECRET_KEY_PRODUCTION

POSTMARK_API_TOKEN=$POSTMARK_API_TOKEN_PRODUCTION

GOOGLE_OAUTH_CLIENT_ID=$GOOGLE_OAUTH_CLIENT_ID

DATABASE_URL=postgres://scholarpremium:$POSTGRES_PASSWORD@10.0.0.3:5432/scholarpremium_production
CABLE_DATABASE_URL=postgres://scholarpremium:$POSTGRES_PASSWORD@10.0.0.3:5432/scholarpremium_production_cable
REDIS_URL=redis://:$REDIS_PASSWORD@10.0.0.3:6379/0
