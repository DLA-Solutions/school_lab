# Copy to .kamal/secrets.staging. Read after .kamal/secrets-common.
# Same database VPS as production, separate databases and a separate Redis logical db.
#
# Required on the deploy machine:
#   JWT_SECRET_KEY_STAGING  API token signing key, different from production's
#   POSTGRES_PASSWORD       password for the scholarpremium PostgreSQL role
#   REDIS_PASSWORD          requirepass value of the Redis instance
#   API_DOCS_USERNAME       HTTP Basic Auth user for /api-docs (staging only)
#   API_DOCS_PASSWORD       HTTP Basic Auth password for /api-docs (staging only)
#   POSTMARK_API_TOKEN_STAGING  Postmark Server API token for transactional e-mail (staging)
#
# Export the two API_DOCS_* variables in the same shell session as `kamal deploy -d staging`,
# or set literals in this gitignored file (e.g. API_DOCS_USERNAME=docs). Run
# `kamal secrets print -d staging` and confirm both values are non-empty before deploying.
# Avoid `#` in API_DOCS_PASSWORD — it breaks .env parsing (same as POSTGRES_PASSWORD).

JWT_SECRET_KEY=$JWT_SECRET_KEY_STAGING

API_DOCS_USERNAME=$API_DOCS_USERNAME
API_DOCS_PASSWORD=$API_DOCS_PASSWORD

POSTMARK_API_TOKEN=$POSTMARK_API_TOKEN_STAGING

# URL-encode POSTGRES_PASSWORD and REDIS_PASSWORD: characters such as @ : / ? # break the URL silently.

DATABASE_URL=postgres://scholarpremium:$POSTGRES_PASSWORD@10.0.0.3:5432/scholarpremium_staging
CABLE_DATABASE_URL=postgres://scholarpremium:$POSTGRES_PASSWORD@10.0.0.3:5432/scholarpremium_staging_cable
REDIS_URL=redis://:$REDIS_PASSWORD@10.0.0.3:6379/1
