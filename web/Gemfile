source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3"
# The modern asset pipeline for Rails [https://github.com/rails/propshaft]
gem "propshaft"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"

# No asset/JS gems: this app is `config.api_only = true` and renders JSON only.
# The product UI lives in frontend/main (React SPA) and app/ (React Native).

# HTTP client for gateway adapters (Faraday + Net::HTTP adapter)
gem "faraday"
# Autentique uploads the contract through the GraphQL multipart spec; Faraday 2 ships the
# multipart middleware as a separate gem.
gem "faraday-multipart"

# Contract PDFs are built in-process. Prawn is pure Ruby, so the image needs no headless browser
# or wkhtmltopdf binary just to render a one-page agreement.
gem "prawn"
gem "prawn-table"
# Prawn reaches for `matrix`, which stopped being a default gem — without it the app fails to boot.
gem "matrix"

# Authentication and API
gem "devise"
gem "jwt"
gem "pundit"
gem "blueprinter"
gem "pagy"
gem "discard"
gem "rack-cors"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ mingw mswin x64_mingw jruby ]

# Use the database-backed adapters for Rails.cache, Active Job, and Action Cable
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# Redis client for optional cache backend (MVP uses Solid Cache on PostgreSQL).
gem "redis", "~> 5.0"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Deploy this application anywhere as a Docker container [https://kamal-deploy.org]
gem "kamal", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"

# Change history for domain records (LGPD / audit trail) — see docs/guidelines/web/auditing.md
gem "audited"

# Finite state machines for domain lifecycles — see docs/guidelines/web/state-machines.md
gem "aasm"
gem "after_commit_everywhere", "~> 1.0"

# OpenAPI browser and static spec — mounted in local dev/test and when EXPOSE_API_DOCS is set (staging).
gem "rswag-api"
gem "rswag-ui"

group :test do
  gem "webmock"
  gem "vcr"
end

group :development, :test do
  gem "debug", platforms: %i[ mri mingw mswin x64_mingw ], require: "debug/prelude"

  gem "dotenv-rails"
  gem "rspec-rails", "~> 8.0"
  gem "factory_bot_rails"
  gem "rswag-specs"
  gem "pdf-inspector", require: "pdf/inspector"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false
end

group :development do
  # Use console on exceptions pages [https://github.com/rails/web-console]
  gem "web-console"
end
