# Copy to mcp.env and fill in secrets. Never commit mcp.env.
#
# Setup:
#   cp .cursor/mcp.env.example .cursor/mcp.env
#   .cursor/scripts/install-github-mcp.sh
#   # then set GITHUB_PERSONAL_ACCESS_TOKEN and Discord bot (or webhook)
#   restart Cursor

# GitHub MCP (stdio). Required scopes: repo, read:project, project
# https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here
GITHUB_TOOLSETS=default,projects

# Discord MCP — School Lab deploy notifications only.
#
# You do not need permission to edit the Discord channel.
#
# Recommended (no Manage Webhooks):
#   1. https://discord.com/developers/applications → New Application → Bot → Reset Token
#      Name the bot "School Lab Deploy". Uncheck Public Bot.
#   2. OAuth2 → URL Generator → scope bot; permissions View Channel, Send Messages, Embed Links
#   3. Send that invite URL to a server admin (they click it once)
#   4. Discord → User Settings → Advanced → Developer Mode
#   5. Right-click the deploy channel → Copy Channel ID (this does not change the channel)
#   6. Fill DISCORD_BOT_TOKEN and DISCORD_DEPLOY_CHANNEL_ID below; restart Cursor
#
# Optional: if an admin can create a webhook, they can paste DISCORD_DEPLOY_WEBHOOK_URL instead.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_DEPLOY_CHANNEL_ID=000000000000000000
DISCORD_DEPLOY_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your_webhook_token_here
