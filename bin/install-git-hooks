#!/usr/bin/env bash
# Point this clone at repo git hooks (.githooks/). Run once per machine/clone.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

chmod +x .githooks/pre-commit .githooks/pre-push 2>/dev/null || true
git config core.hooksPath .githooks

printf 'Git hooks installed (core.hooksPath=.githooks)\n'
printf '  pre-commit — no CI or lint (checks run manually or before deploy)\n'
printf '  pre-push     — no CI (CI runs at deploy only; see deploy-kamal skill)\n'
