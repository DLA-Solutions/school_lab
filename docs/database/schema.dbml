// School Lab — executable schema (DBML)
// Auth: Devise (web session) + refresh_tokens (API JWT)
// Narrative DSL: docs/modeling/001-fintech-first.md, 002-api-auth.md, 003-identity-permissions.md,
//   004-school-onboarding.md, 005-students-enrollments.md, 006-communication.md, 007-academic.md,
//   008-documents-archive.md, 009-platform-admin.md
//
// Soft delete: Discard gem — default column discarded_at (nullable timestamp).
//   kept: discarded_at IS NULL — visible in app queries (Model.kept / default_scope).
//   discarded: set via discard — hidden; FKs and audit history preserved.
// Hard delete: scheduled job removes rows past retention (discarded_at + entity window).
//   Financial/audit tables may skip Discard and purge only by age (see per-table notes).
// Do not use Discard on ephemeral/ingress logs — use revoked_at, expires_at, or age-based purge.
//
// Indexes: unique, partial, and composite indexes are documented explicitly. Plain
//   single-column indexes that Rails creates automatically for `t.references` are
//   documented only on billing/financial tables, where query paths matter for review.
// Check constraints have no DBML representation — they are recorded in column notes
//   (non-negative money, allowed enum values, numeric ranges). Source: web/db/schema.rb.

Table school_groups {
  id integer [primary key, increment]
  name varchar [note: 'Network/holding — optional']
  headquarters_cnpj varchar
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp
}

Table schools {
  id integer [primary key, increment]
  school_group_id integer [note: 'Nullable — only when part of a network']
  name varchar [note: 'E.g. Example School — Downtown Unit']
  cnpj varchar
  address varchar
  timezone varchar [not null, default: 'America/Sao_Paulo', note: 'IANA timezone used for school-local dates and calendar display']
  saas_plan varchar [note: 'Deprecated as source of truth — prefer platform_subscriptions; do not drop in the collection epic']
  onboarding_status varchar [not null, default: 'pending_handoff', note: 'provisioning | pending_handoff | active — see 004-school-onboarding.md']
  onboarding_mode varchar [not null, note: 'self_serve | white_glove — set at create; immutable after active']
  billing_waived_at timestamp [note: 'Handoff when billing setup skipped']
  segments_skipped_at timestamp [note: 'Handoff when segments deferred']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp
}

Table school_modules {
  id integer [primary key, increment]
  school_id integer [not null]
  module_key varchar [not null, note: 'communication | academic | billing | documents — see SchoolLab::SchoolModuleKeys']
  enabled boolean [not null, default: true, note: 'Operator toggle; default all enabled on school create (BR-BO05)']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, module_key) [unique]
  }
}

Table platform_plans {
  id integer [primary key, increment]
  key varchar [not null, note: 'starter | pro | enterprise']
  name varchar [not null]
  monthly_amount_cents integer [not null, note: 'Kept during dual-write; API prefers interval amount_cents from platform_plan_provider_prices']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    key [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

Table platform_plan_provider_prices {
  id integer [primary key, increment]
  platform_plan_id integer [not null]
  provider varchar [not null, note: 'asaas | manual | fake']
  billing_interval varchar [not null, note: 'month | year — Asaas yearly = interval 12 months']
  external_product_id varchar [note: 'Vendor product id when distinct from price']
  external_price_id varchar [note: 'Asaas plan identifier (e.g. starter_monthly)']
  amount_cents integer [not null, note: 'Full interval amount (yearly is the year total, not monthly)']
  active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp

  indexes {
    (platform_plan_id, provider, billing_interval) [unique]
  }
}

Table platform_subscriptions {
  id integer [primary key, increment]
  school_id integer [not null]
  platform_plan_id integer [not null]
  status varchar [not null, default: 'active', note: 'trialing | active | past_due | canceled | incomplete — E3 trial renamed to trialing']
  billing_interval varchar [note: 'month | year']
  provider varchar [not null, default: 'manual', note: 'asaas | manual | fake — row keeps provider if deploy default changes']
  external_customer_id varchar [note: 'Vendor customer id; omit from school SPA JSON']
  external_subscription_id varchar [note: 'Vendor subscription id; omit from school SPA JSON']
  trial_ends_at timestamp [note: 'Optional trial; product default 14 days when offered']
  current_period_start timestamp
  current_period_end timestamp
  cancel_at_period_end boolean [not null, default: false]
  canceled_at timestamp
  collection_method varchar [not null, default: 'manual', note: 'automatic | send_invoice | manual']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    school_id [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL — one kept subscription per school']
    status
    provider
    (provider, external_subscription_id) [unique, note: 'DB migration: UNIQUE WHERE external_subscription_id IS NOT NULL']
  }
}

Table platform_invoices {
  id integer [primary key, increment]
  school_id integer [not null]
  platform_subscription_id integer [not null]
  provider varchar [not null, note: 'asaas | manual | fake']
  external_invoice_id varchar [note: 'Vendor invoice id; omit from school SPA JSON']
  status varchar [not null, default: 'open', note: 'draft | open | paid | void | uncollectible']
  amount_cents integer [not null]
  due_at timestamp
  paid_at timestamp
  hosted_invoice_url varchar [note: 'Asaas secure_url — pay_url for school SPA']
  payment_method varchar [note: 'credit_card | bank_slip | pix']
  created_at timestamp
  updated_at timestamp

  indexes {
    school_id
    (school_id, status)
    platform_subscription_id
    (provider, external_invoice_id) [unique, note: 'DB migration: UNIQUE WHERE external_invoice_id IS NOT NULL']
  }
}

Table platform_billing_settings {
  id integer [primary key, increment]
  active_provider varchar [not null, default: 'manual', note: 'asaas | manual | fake — deploy default; does not rewrite existing subscription.provider']
  webhook_endpoint_token varchar [not null, note: 'URL token for POST /webhooks/platform_billing/:provider/:token — not Asaas API credentials']
  created_at timestamp
  updated_at timestamp

  indexes {
    webhook_endpoint_token [unique]
  }

  Note: 'Singleton application row (exactly one). Asaas API token and base URL live in ENV only (ASAAS_API_TOKEN, ASAAS_API_BASE_URL).'
}

Table platform_impersonation_sessions {
  id integer [primary key, increment]
  operator_user_id integer [not null, note: 'users.id — backoffice operator']
  target_user_id integer [not null, note: 'users.id — impersonated staff user']
  school_id integer [not null]
  target_membership_id integer [not null]
  expires_at timestamp [not null, note: '15-minute TTL']
  ended_at timestamp [note: 'Set when operator ends session']
  created_at timestamp
  updated_at timestamp

  indexes {
    expires_at
    ended_at
  }
}

Table help_taxonomy_categories {
  id integer [primary key, increment]
  name varchar [not null]
  slug varchar [not null]
  module_key varchar [note: 'Optional — communication | academic | billing | documents']
  persona_tags jsonb [not null, default: '[]', note: 'secretary | director | teacher | guardian']
  position integer [not null, default: 0]
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    slug [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    position
  }
}

// --- Identity (Devise) ---

Table users {
  id integer [primary key, increment]
  email varchar [not null, default: '', note: 'LGPD: personal data — partial unique WHERE discarded_at IS NULL']
  encrypted_password varchar [not null, default: '']
  reset_password_token varchar [unique]
  reset_password_sent_at timestamp
  remember_created_at timestamp
  sign_in_count integer [not null, default: 0]
  current_sign_in_at timestamp
  last_sign_in_at timestamp
  current_sign_in_ip varchar
  last_sign_in_ip varchar
  confirmation_token varchar [unique]
  confirmed_at timestamp
  confirmation_sent_at timestamp
  unconfirmed_email varchar
  failed_attempts integer [not null, default: 0]
  unlock_token varchar [unique]
  locked_at timestamp [note: 'Devise lock — failed login attempts; distinct from status disabled']
  status varchar [not null, default: 'active', note: 'active | disabled — platform-wide auth block; revokes refresh_tokens']
  disabled_at timestamp [note: 'Set when status becomes disabled']
  disabled_by_id integer [note: 'Backoffice user who disabled; nullable for system/job']
  discarded_at timestamp [note: 'Discard gem — soft delete; purge after retention']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    email [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

Table memberships {
  id integer [primary key, increment]
  user_id integer [not null]
  school_id integer [note: 'Nullable for platform backoffice']
  role varchar [not null, note: 'backoffice | staff | teacher | guardian — school deprecated, migrate to staff (003)']
  status varchar [not null, default: 'active', note: 'active | invited | suspended — per-school only; global disable is users.status']
  platform_permissions jsonb [not null, default: '[]', note: 'Backoffice only — e.g. provision_school (004-school-onboarding.md)']
  suspended_at timestamp [note: 'Set when status becomes suspended']
  suspended_by_id integer [note: 'School admin who suspended; nullable for system/job']
  discarded_at timestamp [note: 'Discard — removes school link; distinct from suspended']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, school_id, role) [unique, note: 'DB migration target: UNIQUE WHERE discarded_at IS NULL. Allows one account to hold distinct staff/teacher/guardian profiles in the same school; duplicate same-role memberships remain forbidden.']
  }
}

Table refresh_tokens {
  id integer [primary key, increment]
  user_id integer [not null]
  token_digest varchar [not null, unique, note: 'Store hash only — never raw token']
  expires_at timestamp [not null]
  revoked_at timestamp [note: 'No Discard — revoke + purge after expires_at']
  created_at timestamp
}

Table user_identities {
  id integer [primary key, increment]
  user_id integer [not null]
  provider varchar [not null, note: 'google — model validates; extensible later']
  provider_uid varchar [not null, note: 'Google sub — stable subject id']
  email varchar [not null, note: 'Snapshot at link; LGPD contact data']
  email_verified boolean [not null, default: false]
  linked_at timestamp [not null]
  last_used_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (provider, provider_uid) [unique]
    (user_id, provider) [unique]
    user_id
  }
}

Table device_tokens {
  id integer [primary key, increment]
  user_id integer [not null]
  token varchar [not null, note: 'FCM registration token']
  platform varchar [not null, note: 'ios | android | web']
  discarded_at timestamp [note: 'Discard — unregister on logout or token rotation']
  created_at timestamp
  updated_at timestamp

  indexes {
    token [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

// --- Identity: permissions (003) ---

Table school_role_templates {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null, note: 'UI label — e.g. Direção, Recepcionista']
  system_key varchar [note: 'director | secretary | coordination | teacher — null for custom templates']
  is_system boolean [not null, default: false, note: 'Provisioned defaults — not deletable']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, system_key) [note: 'DB migration: UNIQUE WHERE system_key IS NOT NULL AND discarded_at IS NULL']
    school_id
  }
}

Table role_template_permissions {
  id integer [primary key, increment]
  role_template_id integer [not null]
  school_id integer [not null, note: 'Denormalized for tenant scopes']
  permission_key varchar [not null, note: 'Fixed enum in code — see permissions PRD']
  scope_kind varchar [not null, default: 'full', note: 'full | segment | partial']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    (role_template_id, permission_key) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, permission_key)
  }
}

Table segments {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null, note: 'E.g. Early childhood, Elementary — MVP minimum']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name) [note: 'DB migration: UNIQUE WHERE discarded_at IS NULL per school']
  }
}

Table staff_profiles {
  id integer [primary key, increment]
  membership_id integer [not null, note: 'One profile per staff or teacher membership']
  school_id integer [not null, note: 'Denormalized for tenant scopes and owner unique index']
  role_template_id integer [not null, note: 'FK school_role_templates — pointer; edits propagate at runtime']
  is_owner boolean [not null, default: false, note: 'At most one true per school among kept profiles']
  segment_id integer [note: 'Nullable — scope for partial permissions']
  display_title varchar [note: 'Cosmetic UI label — LGPD: may contain personal name']
  also_teaches boolean [not null, default: false, note: 'Coordination template: enables teach permission']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    membership_id [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, is_owner) [note: 'Partial unique WHERE is_owner = true AND discarded_at IS NULL — one owner per school']
  }
}

Table membership_permissions {
  id integer [primary key, increment]
  membership_id integer [not null]
  school_id integer [not null]
  permission_key varchar [not null, note: 'Fixed enum in code — see permissions PRD']
  effect varchar [not null, default: 'grant', note: 'grant | deny — overrides only, not template snapshot']
  discarded_at timestamp [note: 'Discard on revoke']
  created_at timestamp
  updated_at timestamp

  indexes {
    (membership_id, permission_key) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, permission_key)
  }
}

// --- School domain ---

Table guardians {
  id integer [primary key, increment]
  school_id integer [not null]
  user_id integer [note: 'Set when guardian creates account or accepts invite']
  name varchar
  cpf varchar [note: 'LGPD: sensitive personal data']
  email varchar [note: 'LGPD: contact email; may match users.email after signup']
  phone varchar [note: 'LGPD: personal data']
  street varchar [note: 'LGPD: personal address']
  number varchar [note: 'LGPD: personal address']
  complement varchar [note: 'LGPD: personal address']
  neighborhood varchar [note: 'LGPD: personal address']
  city varchar [note: 'LGPD: personal address']
  state varchar(2) [note: 'Two-letter Brazilian state code']
  zip_code varchar(8) [note: 'Digits only']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp
}

Table students {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null, note: 'Persisted full name from PRD full_name concept']
  birth_date date [not null, note: 'LGPD: child data — guardian consent required']
  cpf varchar(11) [note: 'LGPD: child identifier; digits only; optional']
  ra varchar [note: 'School registration identifier; validation format remains school-defined']
  gender varchar [note: 'Optional cadastral value; controlled vocabulary remains a PRD/API decision']
  nationality varchar [note: 'Optional cadastral value; collect only when required']
  segment_id integer [note: 'Nullable — partial staff scopes and class alignment']
  external_code varchar [note: 'Nullable identifier from a legacy SIS or import']
  discarded_at timestamp [note: 'Discard gem — removed from active school records']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, cpf) [unique, note: 'DB migration: UNIQUE WHERE cpf IS NOT NULL AND discarded_at IS NULL']
    (school_id, segment_id)
  }
}

Table teachers {
  id integer [primary key, increment]
  school_id integer [not null]
  user_id integer [note: 'Set when teacher account is provisioned']
  name varchar
  status varchar [default: 'active']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp
  Note: 'Teacher domain record; user_id links the login when provisioned. Membership role remains the authorization context.'
}

Table teacher_health_profiles {
  id integer [primary key, increment]
  school_id integer [not null]
  teacher_id integer [not null]
  blood_type varchar [note: 'A+ | A- | B+ | B- | AB+ | AB- | O+ | O- | unknown — optional']
  health_plan_name varchar(120) [note: 'LGPD: sensitive health data']
  health_plan_number varchar(60) [note: 'LGPD: sensitive health data']
  emergency_contact_name varchar(120) [note: 'LGPD: personal data']
  emergency_contact_phone varchar(30) [note: 'LGPD: personal data; digits normalized in model']
  special_care_notes text [note: 'LGPD: sensitive health data; max 2000 chars in model']
  created_at timestamp
  updated_at timestamp
  Note: 'BC6 collaborator health profile — mirrors student_health_profiles field-for-field, scoped to a Teacher instead of a Student. Profile only; no records list, no document uploads (out of scope per collaborator-health.md).'

  indexes {
    teacher_id [unique, note: 'One profile per teacher']
    school_id
  }
}

Table student_guardians {
  id integer [primary key, increment]
  guardian_id integer [not null]
  student_id integer [not null]
  school_id integer [not null]
  relationship varchar [not null, default: 'other', note: 'parent | guardian | other']
  primary_contact boolean [not null, default: false]
  financial_responsible boolean [not null, default: false, note: 'Exactly one expected when billing is enabled; issuance also validates at application boundary']
  pickup_authorized boolean [not null, default: false]
  discarded_at timestamp [note: 'Discard gem — unlink guardian↔student']
  created_at timestamp
  updated_at timestamp

  indexes {
    (guardian_id, student_id) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (student_id, financial_responsible) [unique, note: 'DB migration intent: UNIQUE WHERE financial_responsible = true AND discarded_at IS NULL']
  }
}

Table student_health_profiles {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  blood_type varchar [note: 'A+ | A- | B+ | B- | AB+ | AB- | O+ | O- | unknown — optional']
  health_plan_name varchar(120) [note: 'LGPD: sensitive health data']
  health_plan_number varchar(60) [note: 'LGPD: sensitive health data']
  emergency_contact_name varchar(120) [note: 'LGPD: personal data']
  emergency_contact_phone varchar(30) [note: 'LGPD: personal data; digits normalized in model']
  special_care_notes text [note: 'LGPD: sensitive health data; max 2000 chars in model']
  created_at timestamp
  updated_at timestamp

  indexes {
    student_id [unique, note: 'One profile per student']
    school_id
  }
}

Table student_health_records {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  title varchar(120) [not null, default: '', note: 'Required label — allergy, medication, condition']
  content text [not null, default: '', note: 'LGPD: sensitive health data; max 5000 chars in model']
  created_by_id integer [note: 'users.id — guardian who created the entry']
  updated_by_id integer [note: 'users.id — last family author']
  content_updated_at timestamp [note: 'Set when content or document changes']
  discarded_at timestamp [note: 'Discard gem — guardian soft delete']
  created_at timestamp
  updated_at timestamp

  Note: 'Optional PDF via has_one_attached :document (Active Storage). application/pdf only; max 10 MB. Not archive_documents in MVP.'

  indexes {
    student_id [note: 'Non-unique — many records per student']
    school_id
    created_by_id
    updated_by_id
  }
}

// --- Billing ---

Table billing_plans {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar
  plan_type varchar [note: 'tuition | enrollment | fee']
  base_amount_cents integer [note: 'Integer cents; nullable — optional template default when every contract carries negotiated_amount_cents. Charge generation resolves negotiated_amount_cents → base_amount_cents → 0. Check constraint: base_amount_cents IS NULL OR base_amount_cents >= 0.']
  discarded_at timestamp [note: 'Discard gem — archived plan']
  created_at timestamp
  updated_at timestamp
}

Table school_payment_providers {
  id integer [primary key, increment]
  school_id integer [not null]
  instrument varchar [not null, note: 'bank_slip | service_invoice — check constraint lists allowed values']
  provider varchar [not null, note: 'cora | fake | spedy — model validates inclusion in the registered adapters']
  active boolean [not null, default: true]
  settings jsonb [not null, default: '{}', note: 'Spedy: spedy_company_id and provider-specific metadata']
  api_key text [note: 'Active Record Encryption — required for spedy (model validation)']
  client_id varchar [note: 'Required for cora (model validation); nullable in DB because fake needs no credentials']
  certificate_pem text [note: 'Active Record Encryption — non-deterministic. Required for cora (model validation)']
  private_key_pem text [note: 'Active Record Encryption — non-deterministic. Required for cora (model validation)']
  certificate_fingerprint varchar [note: 'SHA-256 of cert DER — clear text']
  certificate_expires_at timestamp
  uploaded_at timestamp
  uploaded_by_id integer
  webhook_endpoint_token varchar [not null, note: 'Secret URL segment for unsigned provider notifications; rotatable']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, instrument) [unique, note: 'Partial: WHERE active = true — one active configuration per school and instrument']
    webhook_endpoint_token [unique]
  }
}

Table school_fiscal_settings {
  id integer [primary key, increment]
  school_id integer [not null, unique]
  enabled boolean [not null, default: false, note: 'True only when config complete and city validated against Spedy']
  issuance_city_name varchar [not null]
  issuance_state varchar(2) [not null]
  spedy_city_code integer [not null, note: 'IBGE code from Spedy GET /cities']
  provider_options_snapshot jsonb [not null, default: '{}', note: 'Cached provider.options at city selection']
  federal_service_code varchar
  cnae_code varchar
  city_service_code varchar
  nbs_code varchar
  national_taxation_code varchar
  iss_rate_percent decimal(5,2) [note: 'ISS rate sent in total.issRate']
  service_description varchar(100)
  taxation_type varchar [not null, default: 'taxationInMunicipality']
  tax_location varchar [not null, default: 'companyMunicipality']
  issue_type varchar [note: 'annfs | website | alt — Spedy company serviceInvoice.issueType']
  reform_tributaria_enabled boolean [not null, default: false]
  ibs_cbs_config jsonb [not null, default: '{}']
  created_at timestamp
  updated_at timestamp
}

Table school_billing_settings {
  id integer [primary key, increment]
  school_id integer [not null, unique]
  overdue_grace_days integer [not null, default: 3, note: '0–30 days before a charge is marked overdue. Check constraint: BETWEEN 0 AND 30.']
  service_description varchar(100) [note: 'Guardian-facing boleto line; default from i18n']
  notification_schedule jsonb [not null, default: '{}', note: 'Future platform email régua rules relative to due date — not consumed in MVP']
  interest_rate_percent decimal(5,2) [note: 'Monthly mora interest % sent to Cora payment_terms.interest.rate. No default; issuance blocked when NULL.']
  early_payment_discount_percent decimal(5,2) [note: 'Pontualidade % sent to Cora payment_terms.discount (PERCENT). NULL = off. Check: NULL or (0, 100]. Cora default limit = day before due — no custom date.']
  fine_type varchar [note: '"percent" | "fixed" | NULL (off). When NULL, fine_rate_percent and fine_amount_cents must be NULL.']
  fine_rate_percent decimal(5,2) [note: 'When fine_type = percent: (0, 100]; fine_amount_cents must be NULL.']
  fine_amount_cents integer [note: 'When fine_type = fixed: > 0; fine_rate_percent must be NULL. Sent to Cora payment_terms.fine.amount.']
  created_at timestamp
  updated_at timestamp
}

Table billing_purposes {
  id integer [primary key, increment]
  school_id integer [not null]
  code varchar [not null, note: 'English stable identifier, e.g. tuition | enrollment | material | activity | transport | meal | other']
  name varchar [not null, note: 'School-facing display name']
  tax_declaration_eligible boolean [not null, default: false, note: 'Applies to future charges only. Tuition/enrollment may be provisionally seeded true but release remains blocked until legal/accounting approval.']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, code) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table tax_declaration_settings {
  id integer [primary key, increment]
  school_id integer [not null, unique]
  document_signatory_id integer [note: 'Required for generation; same-school active signatory']
  legal_text text [note: 'Approved declaration wording; version is snapshotted on generation']
  legal_text_version varchar
  configuration_version integer [not null, default: 1, note: 'Incremented whenever legal text, signatory, or approved eligible-purpose configuration changes']
  approved_purpose_configuration_digest varchar [note: 'Digest of approved billing purpose codes/eligibility used as generation release gate']
  legal_accounting_approved_at timestamp [note: 'Release gate acknowledgment; engineering does not infer Brazilian tax eligibility']
  approved_by_id integer
  created_at timestamp
  updated_at timestamp
}

Table tax_declarations {
  id integer [primary key, increment]
  school_id integer [not null]
  guardian_id integer [not null, note: 'Payer guardian; not merely any guardian linked to the student']
  calendar_year integer [not null, note: 'Gregorian calendar year in school timezone; only closed years']
  active_version_id integer [note: 'Current immutable version; FK to tax_declaration_versions added after both tables exist']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, guardian_id, calendar_year) [unique, note: 'One logical declaration per payer/school/calendar year']
  }
}

Table tax_declaration_versions {
  id integer [primary key, increment]
  school_id integer [not null]
  tax_declaration_id integer [not null]
  version integer [not null]
  supersedes_id integer
  calculation_digest varchar [not null, note: 'Digest of payment ids/amounts, charge classification snapshots, and approved config; idempotency key']
  total_declared_principal_amount_cents integer [not null, note: 'Sum of eligible settled principal after discounts, excluding fine and interest; check >= 0']
  settings_version integer [not null, note: 'tax_declaration_settings.configuration_version approved for this immutable version']
  school_identity_snapshot jsonb [not null, note: 'Legal name, CNPJ, and address fields used in this version']
  payer_identity_snapshot jsonb [not null, note: 'LGPD: payer name/CPF used in this version']
  legal_text_snapshot text [not null]
  legal_text_version_snapshot varchar [not null]
  document_signatory_snapshot jsonb [not null, note: 'Exactly one signatory id/name/title as issued; live signatory changes do not alter this version']
  purpose_configuration_snapshot jsonb [not null, note: 'Approved purpose codes, future-charge eligibility values, configuration digest, and approval metadata']
  approval_snapshot jsonb [not null, note: 'Legal/accounting approved_at and approved_by identifiers for the selected settings version']
  calculation_snapshot jsonb [not null, note: 'Per-student and per-purpose totals; immutable']
  verification_code varchar [not null, unique]
  pdf_storage_key varchar [not null, note: 'Active Storage/blob reference or equivalent; bytes generated only from snapshot']
  issued_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
  Note: 'Append-only fiscal/LGPD record. Corrections create a new version; no Discard. Retention pending legal review.'

  indexes {
    (tax_declaration_id, version) [unique]
    (tax_declaration_id, calculation_digest) [unique]
  }
}

Table tax_declaration_items {
  id integer [primary key, increment]
  school_id integer [not null]
  tax_declaration_version_id integer [not null]
  student_id integer [not null]
  payment_id integer [not null]
  charge_id integer [not null]
  billing_purpose_code varchar [not null, note: 'Copied from immutable charge classification']
  paid_at timestamp [not null]
  source_paid_amount_cents integer [not null]
  source_fine_amount_cents integer [not null, default: 0]
  source_interest_amount_cents integer [not null, default: 0]
  declared_principal_amount_cents integer [not null, note: 'source_paid - source_fine - source_interest; check >= 0']
  created_at timestamp
  updated_at timestamp
  Note: 'Immutable payment traceability; no Discard. One source payment appears at most once in a version.'

  indexes {
    (tax_declaration_version_id, payment_id) [unique]
    (tax_declaration_version_id, student_id)
  }
}

Table tax_declaration_access_events {
  id integer [primary key, increment]
  school_id integer [not null]
  tax_declaration_id integer [not null]
  tax_declaration_version_id integer [not null]
  guardian_id integer [not null, note: 'Authenticated payer guardian whose family-scoped request succeeded']
  actor_user_id integer [not null]
  event_type varchar [not null, default: 'pdf_download', note: 'pdf_download']
  request_uuid varchar [not null, unique, note: 'Idempotent request correlation; no CPF or financial line items']
  occurred_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
  Note: 'Append-only read-access audit. No Discard; retention remains legal/LGPD gated.'

  indexes {
    (school_id, guardian_id, occurred_at)
    (tax_declaration_version_id, occurred_at)
  }
}

Table contracts {
  id integer [primary key, increment]
  student_id integer [not null]
  school_id integer [not null]
  billing_plan_id integer [not null]
  enrollment_id integer [note: 'Nullable handoff to students domain; when present, enrollment must match school_id and student_id; legacy contracts remain student-scoped']
  negotiated_amount_cents integer [note: 'Monetary amounts stored as integer cents. Check constraint: negotiated_amount_cents IS NULL OR negotiated_amount_cents >= 0.']
  due_day integer [note: '1–28']
  starts_on date
  ends_on date
  status varchar [not null, default: 'active', note: 'active | suspended | ended']
  discarded_at timestamp [note: 'Discard gem — distinct from status ended']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, status)
    enrollment_id
  }
}

Table charges {
  id integer [primary key, increment]
  contract_id integer [not null]
  school_id integer [not null]
  guardian_id integer [not null, note: 'Financially responsible guardian for this charge']
  billing_purpose_id integer [note: 'Required for new charges; nullable only for legacy rows pending verified classification']
  billing_purpose_code varchar [note: 'Immutable purpose code captured when charge is created']
  tax_declaration_eligible boolean [not null, default: false, note: 'Immutable eligibility captured from billing_purposes at charge creation; later school setting changes do not reclassify this charge']
  billing_period date [not null, note: 'First day of billing month — e.g. 2026-08-01']
  original_amount_cents integer [not null, note: 'Monetary amounts stored as integer cents. Check constraint: >= 0.']
  discount_amount_cents integer [not null, default: 0, note: 'Check constraint: >= 0']
  late_fee_amount_cents integer [not null, default: 0, note: 'Check constraint: >= 0. Stays 0 today — Billing::LateFeeCalculator is a zero-returning placeholder until the fee rule is decided.']
  total_amount_cents integer [not null, note: 'original - discount + late fee. Check constraint: >= 0.']
  due_date date
  status varchar [not null, default: 'pending', note: 'pending | paid | overdue | cancelled — business state; discard for erroneous removal']
  provider_invoice_id varchar [note: 'Cached active provider invoice id — canonical history in charge_issuances']
  boleto_url varchar [note: 'Cached last-issued boleto URL for guardian display']
  pix_copy_paste text [note: 'Cached last-issued Pix EMV for guardian display']
  paid_at timestamp [note: 'AASM timestamp — set on pay transition']
  overdue_at timestamp [note: 'AASM timestamp — set on mark_overdue transition']
  cancelled_at timestamp [note: 'AASM timestamp — set on cancel transition']
  discarded_at timestamp [note: 'Discard gem — erroneous/duplicate charge removal']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp

  indexes {
    (contract_id, billing_period) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, status)
    (school_id, due_date)
    provider_invoice_id [unique, note: 'WHERE provider_invoice_id IS NOT NULL']
    contract_id
    guardian_id
    school_id
    discarded_by_id
  }
}

Table collection_reminder_deliveries {
  id integer [primary key, increment]
  school_id integer [not null]
  charge_id integer [not null]
  rule_key varchar [not null, note: 'e.g. days_after_due:3, overdue_transition']
  sent_on date [not null, note: 'School timezone date — deduplicates same-day reminders per rule']
  created_at timestamp
  updated_at timestamp

  indexes {
    (charge_id, rule_key, sent_on) [unique]
    (school_id, sent_on)
    school_id
    charge_id
  }
}

Table charge_issuances {
  id integer [primary key, increment]
  charge_id integer [not null]
  school_id integer [not null]
  provider varchar [not null, note: 'Payment provider identifier — e.g. cora, fake; not a generic PSP label']
  provider_invoice_id varchar [note: 'Provider invoice id; partial unique when present']
  idempotency_key varchar [not null, note: 'Persisted before HTTP — retry-safe issuance']
  status varchar [not null, default: 'pending', note: 'pending | issued | failed | cancelled']
  amount_cents integer [not null, note: 'Snapshot of charge total at issuance time. Check constraint: >= 0.']
  due_date date [not null, note: 'Snapshot of charge due date at issuance time']
  boleto_url varchar
  digitable_line varchar
  barcode varchar
  our_number varchar
  pix_emv text
  issued_at timestamp
  cancelled_at timestamp
  last_error text [note: 'Provider error on failed transition']
  created_at timestamp
  updated_at timestamp
  Note: 'One row per bank invoice; immutable financial record — cancel via status, not Discard'

  indexes {
    idempotency_key [unique]
    provider_invoice_id [unique, note: 'WHERE provider_invoice_id IS NOT NULL']
    (charge_id, status)
    charge_id
    school_id
  }
}

Table applied_discounts {
  id integer [primary key, increment]
  charge_id integer [not null]
  school_id integer [not null]
  discount_type varchar
  amount_cents integer [note: 'Integer cents; nullable until discount application ships. Fixed-amount discount lines must set amount_cents; percentage discounts may leave NULL until a rate column exists. Check constraint: amount_cents IS NULL OR amount_cents >= 0.']
  discarded_at timestamp [note: 'Discard gem — discount line removed']
  created_at timestamp
  updated_at timestamp

  indexes {
    charge_id
    school_id
  }
}

Table service_invoices {
  id integer [primary key, increment]
  school_id integer [not null]
  payment_id integer [not null, note: 'One NFS-e per confirmed payment — BR-I02']
  charge_id integer [not null]
  provider varchar [not null, note: 'spedy | fake']
  provider_document_id varchar [note: 'Spedy document id; partial unique when present']
  integration_id varchar [not null, note: 'Stable idempotency key pay-{payment_id}']
  status varchar [not null, default: 'pending', note: 'pending | enqueued | authorized | rejected | canceled | failed']
  invoice_number varchar
  verification_code varchar
  access_key varchar
  pdf_blob_key varchar [note: 'Active Storage attachment key after authorization']
  xml_blob_key varchar
  enqueued_at timestamp
  authorized_at timestamp
  rejected_at timestamp
  failed_at timestamp
  canceled_at timestamp
  last_error text [note: 'Redacted provider error on failed/rejected']
  created_at timestamp
  updated_at timestamp
  Note: 'Immutable fiscal record — cancel via status, not Discard'

  indexes {
    payment_id [unique]
    integration_id [unique]
    provider_document_id [unique, note: 'WHERE provider_document_id IS NOT NULL']
    (school_id, status)
    charge_id
    school_id
  }
}

Table service_invoice_attempts {
  id integer [primary key, increment]
  service_invoice_id integer [not null]
  school_id integer [not null]
  provider varchar [not null]
  idempotency_key varchar [not null]
  status varchar [not null, default: 'pending', note: 'pending | enqueued | failed']
  provider_response jsonb [note: 'Last provider payload snapshot — redacted']
  last_error text
  enqueued_at timestamp
  failed_at timestamp
  created_at timestamp
  updated_at timestamp
  Note: 'One row per HTTP attempt — mirrors charge_issuances'

  indexes {
    idempotency_key [unique]
    service_invoice_id
    school_id
  }
}

Table payments {
  id integer [primary key, increment]
  charge_id integer [not null]
  school_id integer [not null]
  paid_amount_cents integer [not null, note: 'Monetary amounts stored as integer cents. Check constraint: >= 0.']
  fine_amount_cents integer [not null, default: 0, note: 'Bank-reported fine component at settlement. Check constraint: >= 0.']
  interest_amount_cents integer [not null, default: 0, note: 'Bank-reported interest component at settlement. Check constraint: >= 0.']
  payment_method varchar [note: 'boleto | pix | card']
  provider_payment_id varchar [note: 'Provider settlement id; partial unique when present']
  paid_at timestamp
  status varchar [not null, default: 'confirmed']
  created_at timestamp
  updated_at timestamp
  Note: 'No Discard — immutable financial record; hard delete only after legal retention'

  indexes {
    provider_payment_id [unique, note: 'WHERE provider_payment_id IS NOT NULL']
    charge_id
    school_id
  }
}

Table webhook_events {
  id integer [primary key, increment]
  school_id integer [note: 'Tenant that received the notification; nullable for platform billing until external_subscription_id is matched']
  provider varchar [not null, note: 'cora | fake | asaas']
  provider_event_id varchar [not null, note: 'Idempotency key from provider — unique per provider']
  event_type varchar
  provider_resource_id varchar [note: 'Normalized invoice/resource id from the notification']
  payload text [note: 'Raw notification body when the provider sends one; NULL for Cora, whose notification carries only event headers']
  processing_error text [note: 'Mismatch or permanent failure details — no PII']
  observed_status varchar [note: 'Invoice status observed during reconciliation']
  processed_at timestamp [note: 'Set when reconciliation finishes; drives the purge window']
  created_at timestamp
  updated_at timestamp
  Note: 'No Discard — ingress audit log. Processed rows are purged 180 days after processed_at (Billing::PurgeWebhookEventsJob; window from config.x.billing.webhook_events_retention_days, override via WEBHOOK_EVENTS_RETENTION_DAYS). Unprocessed rows (processed_at IS NULL) are never purged — they represent unreconciled money movement.'

  indexes {
    (provider, provider_event_id) [unique]
    school_id
  }
}

// --- Documents (MVP: enrollment/KYC docs — not full digital archive) ---

Table documents {
  id integer [primary key, increment]
  school_id integer [not null, note: 'Per-school isolation — required even for polymorphic parent']
  documentable_type varchar [not null, note: 'School | Guardian | Student — Teacher deferred to academic phase']
  documentable_id integer [not null]
  document_type varchar
  status varchar [not null, default: 'pending', note: 'pending | approved | rejected']
  rejection_reason varchar
  uploaded_by_id integer
  reviewed_at timestamp
  discarded_at timestamp [note: 'Discard gem — removed from active archive']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp

  indexes {
    (documentable_type, documentable_id)
    (school_id, status)
  }
}

// --- Onboarding (004) ---

Table membership_invite_tokens {
  id integer [primary key, increment]
  membership_id integer [not null]
  school_id integer [not null]
  token_digest varchar [not null, unique, note: 'SHA-256 of opaque token — never store raw token']
  expires_at timestamp [not null, note: 'Default created_at + 7 days']
  used_at timestamp [note: 'Set on successful POST /auth/invite/accept']
  created_by_id integer [note: 'users.id — inviter; nullable for system']
  created_at timestamp
  updated_at timestamp

  indexes {
    membership_id [note: 'At most one unused token per membership — invalidate on resend; partial unique WHERE used_at IS NULL TBD']
    (school_id, expires_at)
  }
}

Table provisioning_imports {
  id integer [primary key, increment]
  school_id integer [not null]
  uploaded_by_id integer [not null, note: 'users.id — backoffice actor']
  status varchar [not null, default: 'previewed', note: 'previewed | committed | failed']
  row_count integer
  error_report jsonb [note: 'Validation errors from dry_run — LGPD: may contain PII']
  committed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, created_at)
  }
}

// --- Platform & admin (009) ---

Table school_years {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null, note: 'E.g. 2026']
  starts_on date [not null]
  ends_on date [not null, note: 'Check constraint intent: ends_on >= starts_on']
  period_template varchar [not null, default: 'trimester', note: 'bimester | trimester | custom']
  status varchar [not null, default: 'draft', note: 'draft | active | archived']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, status) [unique, note: 'DB migration: UNIQUE WHERE status = active AND discarded_at IS NULL — one active year per school']
  }
}

Table academic_periods {
  id integer [primary key, increment]
  school_year_id integer [not null]
  school_id integer [not null, note: 'Denormalized for tenant scopes']
  name varchar [not null]
  sequence integer [not null]
  starts_on date [not null, note: 'Must fall within school year bounds']
  ends_on date [not null, note: 'Check constraint intent: ends_on >= starts_on; periods in a year must not overlap']
  closure_status varchar [not null, default: 'open', note: 'open | closing | closed — academic BC6']
  attendance_policy_override jsonb [note: 'Optional period override of school attendance policy; immutable once closure_status = closed']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_year_id, sequence) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table school_holidays {
  id integer [primary key, increment]
  school_id integer [not null]
  school_year_id integer [not null]
  date date [not null]
  name varchar [not null]
  applies_to_attendance boolean [not null, default: true]
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_year_id, date) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table calendar_events {
  id integer [primary key, increment]
  school_id integer [not null]
  school_year_id integer [note: 'Nullable — events outside the active year remain queryable by date range']
  user_id integer [note: 'Nullable — institutional event when null; present for owner-only personal event']
  title varchar [not null, note: 'LGPD: may contain personal data']
  description text [note: 'LGPD: may contain personal data']
  starts_at timestamp [not null]
  ends_at timestamp [note: 'Check constraint intent: NULL or ends_at >= starts_at']
  all_day boolean [not null, default: false]
  visibility varchar [not null, default: 'school', note: 'school | staff_only; personal rows remain owner-only regardless of value']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, starts_at)
    (school_id, school_year_id, starts_at)
    (user_id, starts_at)
  }
}

// --- Students & enrollments (005) ---

Table classes {
  id integer [primary key, increment]
  school_id integer [not null]
  school_year_id integer [not null]
  segment_id integer
  name varchar [not null]
  grade_level varchar [note: 'School-defined grade/series label']
  shift varchar [note: 'morning | afternoon | night | full']
  capacity integer [note: 'Check constraint: NULL OR capacity > 0']
  parent_class_id integer [note: 'Multigrade parent turma — self FK']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, school_year_id, name) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

Table class_assignments {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  student_id integer [not null]
  school_year_id integer [not null]
  assigned_on date
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (student_id, school_year_id) [unique, note: 'One active class per student per year WHERE discarded_at IS NULL']
  }
}

Table enrollments {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null, note: 'Must belong to school_id']
  school_year_id integer [not null, note: 'Must belong to school_id']
  status varchar [not null, default: 'active', note: 'draft | active | completed | withdrawn']
  enrollment_kind varchar [not null, default: 'new', note: 'new | returning — reporting only']
  enrolled_on date
  class_assignment_id integer [note: 'When present, assignment must match school_id, student_id, and school_year_id']
  withdrawal_reason text [note: 'Required by application on transition to withdrawn; audited']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (student_id, school_year_id, status) [unique, note: 'DB migration: UNIQUE WHERE status = active AND discarded_at IS NULL']
    (school_id, status)
  }
}

Table enrollment_contract_templates {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null]
  body_html text [not null, note: 'Merge template source; generated PDF is stored through documents handoff']
  version integer [not null, default: 1, note: 'Immutable template revision number']
  discarded_at timestamp [note: 'Discard gem — prevents new bindings while preserving existing contracts']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name, version) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

Table enrollment_contracts {
  id integer [primary key, increment]
  school_id integer [not null]
  enrollment_id integer [not null, note: 'Enrollment must match school_id']
  template_id integer [not null, note: 'Template must match school_id']
  template_version integer [not null, note: 'Snapshot of bound template revision']
  document_id integer [note: 'Nullable generated PDF in archive_documents; archive document must match enrollment school_id and student_id']
  signature_status varchar [not null, default: 'pending', note: 'pending | sent | signed | declined | expired — phase 2 signature provider']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table consent_records {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  guardian_id integer [not null]
  consent_type varchar [not null, note: 'data_processing | communication | photo_use']
  policy_version varchar [not null]
  granted_at timestamp [not null]
  revoked_at timestamp
  channel varchar [not null, note: 'web | app | paper_scan']
  archive_document_id integer [note: 'Required when channel = paper_scan; evidence must match school_id and student_id']
  recorded_by_id integer [note: 'users.id — staff recorder when not self-service']
  created_at timestamp
  updated_at timestamp

  indexes {
    (student_id, guardian_id, consent_type) [unique, note: 'DB migration: UNIQUE WHERE revoked_at IS NULL; re-consent atomically revokes the prior policy version before insert']
  }
}

Table enrollment_imports {
  id integer [primary key, increment]
  school_id integer [not null]
  uploaded_by_id integer [not null, note: 'users.id — staff actor with manage_enrollment']
  original_filename varchar
  status varchar [not null, default: 'previewed', note: 'previewed | committed | failed; commit is all-or-nothing per batch']
  row_count integer
  error_report jsonb [note: 'Row-level validation results — LGPD: may contain student/guardian PII']
  committed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, created_at)
  }
}

// --- Communication (006) ---

Table conversations {
  id integer [primary key, increment]
  school_id integer [not null]
  conversation_type varchar [not null, note: 'direct | class | group']
  subject_type varchar [note: 'Polymorphic — Class, Student, etc.']
  subject_id integer
  last_message_at timestamp
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, last_message_at)
  }
}

Table conversation_participants {
  id integer [primary key, increment]
  conversation_id integer [not null]
  school_id integer [not null]
  participant_type varchar [not null, note: 'Membership | Guardian']
  participant_id integer [not null]
  last_read_at timestamp
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (conversation_id, participant_type, participant_id) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table messages {
  id integer [primary key, increment]
  conversation_id integer [not null]
  school_id integer [not null]
  sender_membership_id integer [note: 'Nullable for system messages']
  body text [not null, note: 'LGPD: message content']
  sent_at timestamp [not null]
  edited_at timestamp
  scheduled_for timestamp
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (conversation_id, sent_at)
  }
}

Table announcements {
  id integer [primary key, increment]
  school_id integer [not null]
  author_membership_id integer [not null]
  title varchar [not null]
  body text [not null]
  target_scope varchar [not null, note: 'school | class | segment']
  target_id integer [note: 'class_id or segment_id when scoped']
  published_at timestamp
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp
}

// Per school × channel_key toggles (BR-N02, BR-N03). No row = fall back to the hardcoded MVP
// default (push on, email/whatsapp off) — a row only exists once staff overrides it.
Table notification_policies {
  id integer [primary key, increment]
  school_id integer [not null]
  channel_key varchar [not null, note: 'messages | announcements | service_tickets | attendance | photos | report_cards, non-exhaustive per BR-N02']
  push_enabled boolean [not null, default: true]
  email_enabled boolean [not null, default: false]
  whatsapp_enabled boolean [not null, default: false]
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, channel_key) [unique]
  }
}

// One row per domain event fan-out (BR-N01, UC-N01). `payload` carries push title/body/deep-link
// context only — never message body text (LGPD minimization).
Table notification_intents {
  id integer [primary key, increment]
  school_id integer [not null]
  channel_key varchar [not null, note: 'Resolves the effective notification_policies row']
  source_type varchar [not null, note: 'ReportCardSnapshot | Message | Announcement | AbsenceRecorded, …']
  source_id integer [not null]
  payload jsonb [not null, default: '{}', note: 'Push title/body/deep-link context']
  created_at timestamp
  updated_at timestamp

  indexes {
    (source_type, source_id, channel_key) [unique, note: 'Idempotent intent creation on event retry']
  }
}

// Per user × channel delivery state (BR-N04, BR-N05). AASM: queued -> sent | failed | skipped.
Table notification_deliveries {
  id integer [primary key, increment]
  school_id integer [not null]
  notification_intent_id integer [not null]
  user_id integer [not null, note: 'Recipient resolved from the intent target users']
  channel varchar [not null, note: 'push | email | whatsapp']
  status varchar [not null, default: 'queued', note: 'queued | sent | failed | skipped (policy off)']
  attempts integer [not null, default: 0, note: 'Retry count for exponential backoff — BR-N05']
  sent_at timestamp
  error_code varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (notification_intent_id, channel, user_id) [unique, note: 'Idempotent delivery — BR-N05']
  }
}

// --- Academic (007) ---

Table subjects {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null]
  code varchar
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name) [unique, note: 'WHERE discarded_at IS NULL']
    (school_id, code) [unique, note: 'WHERE code IS NOT NULL AND discarded_at IS NULL']
  }
}

Table class_disciplines {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  subject_id integer [not null]
  school_year_id integer [not null]
  teacher_id integer
  required_on_report_card boolean [not null, default: true]
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (class_id, subject_id) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table attendance_policies {
  id integer [primary key, increment]
  school_id integer [not null, unique]
  counting_mode varchar [not null, default: 'lesson', note: 'lesson | period_total']
  late_counts_as_absence boolean [not null, default: false, note: 'Controls report-card numerator; late always remains in denominator']
  auto_confirm_absence_after_minutes integer [not null, default: 15, note: 'Check > 0']
  created_at timestamp
  updated_at timestamp
}

Table attendance_sessions {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  school_year_id integer [not null]
  academic_period_id integer
  lesson_id integer [note: 'Required when attendance policy counting_mode = lesson; null for period_total roll']
  session_date date [not null]
  recorded_by_membership_id integer
  confirmed_at timestamp [note: 'After 15-minute auto-confirm delay']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (class_id, session_date, lesson_id) [unique, note: 'Partial unique WHERE lesson_id IS NOT NULL AND discarded_at IS NULL']
    (class_id, academic_period_id, session_date) [unique, note: 'Partial unique WHERE lesson_id IS NULL AND discarded_at IS NULL — one period-total roll per class/date']
  }
}

Table attendance_records {
  id integer [primary key, increment]
  attendance_session_id integer [not null]
  school_id integer [not null]
  student_id integer [not null]
  status varchar [not null, note: 'present | absent | late | excused']
  absence_notified_at timestamp
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (attendance_session_id, student_id) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table absence_justifications {
  id integer [primary key, increment]
  school_id integer [not null]
  attendance_record_id integer [not null]
  submitted_by_membership_id integer [not null]
  reason_code varchar [not null]
  explanation text [note: 'LGPD: may contain child health/family information; minimize and retain per approved policy']
  attachment_storage_key varchar
  status varchar [not null, default: 'pending', note: 'pending | approved | rejected']
  reviewed_by_membership_id integer
  reviewed_at timestamp
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, status, created_at)
    (attendance_record_id, created_at)
  }
}

Table attendance_exports {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  academic_period_id integer
  requested_by_membership_id integer [not null]
  format varchar [not null, note: 'pdf | csv']
  status varchar [not null, default: 'pending', note: 'pending | processing | completed | failed']
  filter_snapshot jsonb [not null, default: '{}']
  storage_key varchar
  completed_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table grade_scales {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null]
  scale_type varchar [not null, note: 'numeric | concept | rubric']
  version integer [not null]
  configuration jsonb [not null, default: '{}', note: 'Numeric bounds/precision or concept/rubric allowed values']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name, version) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table evaluation_templates {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  academic_period_id integer [not null]
  version integer [not null]
  supersedes_id integer
  retired_at timestamp [note: 'Current template has retired_at NULL; replaced versions remain immutable for existing entries']
  rounding_mode varchar [not null, default: 'half_up']
  lock_on_launch boolean [not null, default: false]
  created_by_membership_id integer [not null]
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, class_id, academic_period_id, version) [unique, note: 'WHERE discarded_at IS NULL']
    (school_id, class_id, academic_period_id) [unique, note: 'Partial unique WHERE retired_at IS NULL AND discarded_at IS NULL — one current template for the class/period']
  }
}

Table evaluation_components {
  id integer [primary key, increment]
  school_id integer [not null]
  evaluation_template_id integer [not null]
  class_discipline_id integer [not null]
  grade_scale_id integer [not null]
  name varchar [not null]
  weight_percent decimal(5,2) [not null, note: 'Template regular-component weights sum to 100 unless explicit extra-credit rule']
  entry_kind varchar [not null, default: 'regular', note: 'regular | recovery']
  position integer [not null]
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (evaluation_template_id, class_discipline_id, position) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table grade_entries {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  class_discipline_id integer [not null]
  academic_period_id integer [not null]
  evaluation_component_id integer [not null]
  lesson_id integer
  activity_id integer
  entry_kind varchar [not null, default: 'regular', note: 'regular | recovery; must match component']
  value varchar [note: 'Numeric or concept — LGPD: academic record']
  entered_by_membership_id integer
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (evaluation_component_id, student_id, lesson_id, activity_id) [unique, note: 'PostgreSQL NULLS NOT DISTINCT partial unique WHERE discarded_at IS NULL — idempotent grade cell identity even when lesson/activity is null']
  }
}

Table grade_overrides {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  class_discipline_id integer [not null]
  academic_period_id integer [not null]
  computed_value varchar [not null]
  override_value varchar [not null]
  reason_code varchar [not null]
  applied_by_membership_id integer [not null]
  supersedes_id integer
  superseded_at timestamp
  created_at timestamp
  updated_at timestamp
  Note: 'Append-only audited override of one computed student/discipline/period result. Current row has superseded_at NULL; correction appends and supersedes.'

  indexes {
    (school_id, student_id, class_discipline_id, academic_period_id) [unique, note: 'Partial unique WHERE superseded_at IS NULL — one current override per computed result']
  }
}

Table grade_launches {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  class_discipline_id integer [not null]
  academic_period_id integer [not null]
  launched_by_membership_id integer [not null]
  supersedes_id integer [note: 'Prior invalidated launch replaced by this append-only relaunch']
  status varchar [not null, default: 'launched', note: 'launched | invalidated; readiness requires launched plus matching current digest']
  launched_at timestamp [not null]
  input_digest varchar [not null, note: 'Traceable digest of launched grade entries/formula version']
  invalidated_at timestamp
  invalidation_reason varchar [note: 'Audited source-change reason; required when status = invalidated']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, class_discipline_id, academic_period_id, input_digest) [unique]
    (school_id, class_discipline_id, academic_period_id) [unique, note: 'Partial unique WHERE status = launched — at most one current non-invalidated launch']
  }
}

Table report_card_configs {
  id integer [primary key, increment]
  school_id integer [not null]
  version integer [not null]
  template_key varchar [not null, note: 'Versioned standard engine template reference; no executable arbitrary template']
  display_config jsonb [not null, default: '{}', note: 'Visible columns, discipline rules, numeric/concept and attendance display modes']
  header_text text
  footer_text text
  document_signatory_id integer [not null, note: 'Exactly one same-school active signatory per config version']
  created_by_membership_id integer [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, version) [unique]
  }
}

Table report_card_publish_batches {
  id integer [primary key, increment]
  school_id integer [not null]
  class_id integer [not null]
  academic_period_id integer [not null]
  requested_by_membership_id integer [not null]
  mode varchar [not null, note: 'immediate | scheduled']
  status varchar [not null, default: 'processing', note: 'scheduled | processing | completed | failed']
  force_publish_reason text
  requested_count integer [not null, default: 0]
  released_count integer [not null, default: 0, note: 'Atomic invariant: completed equals requested; failed equals 0']
  failed_count integer [not null, default: 0]
  blockers jsonb [not null, default: '[]', note: 'Structured per-student blockers; no sensitive details in logs']
  completed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, class_id, academic_period_id, status)
  }
}

Table report_card_publish_schedules {
  id integer [primary key, increment]
  school_id integer [not null]
  report_card_publish_batch_id integer [not null, unique]
  scheduled_for timestamp [not null, note: 'UTC instant derived from school_timezone']
  school_timezone varchar [not null, note: 'IANA timezone used to interpret the request']
  status varchar [not null, default: 'scheduled', note: 'scheduled | processing | completed | failed']
  queue_job_reference varchar [note: 'Internal Solid Queue correlation; never exposed as product id']
  executed_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table report_card_publications {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  academic_period_id integer [not null]
  active_snapshot_id integer [note: 'Current released version; FK to report_card_snapshots added after both tables exist']
  created_by_membership_id integer [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, student_id, academic_period_id) [unique, note: 'One logical publication; corrections are snapshot versions']
  }
}

Table report_card_snapshots {
  id integer [primary key, increment]
  school_id integer [not null]
  report_card_publication_id integer [not null]
  report_card_publish_batch_id integer [note: 'Atomic class batch that first released this snapshot; null only for individual correction/legacy rows']
  report_card_config_id integer [not null]
  version integer [not null]
  supersedes_id integer
  grade_launch_digest varchar [not null]
  snapshot jsonb [not null, note: 'Immutable student/period/config, launched grades/formulas/overrides, visibility, attendance denominator/numerator/counts/late policy/percentage']
  correction_reason text
  released_at timestamp [not null]
  pdf_storage_key varchar [not null, note: 'Rendered only from snapshot; row is inserted only after bytes stage successfully']
  created_at timestamp
  updated_at timestamp
  Note: 'Append-only released academic record; no persisted draft snapshot. Guardian visibility requires released_at <= now.'

  indexes {
    (report_card_publication_id, version) [unique]
  }
}

Table preceptorship_reports {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  teacher_id integer [not null]
  academic_period_id integer
  author_id integer
  body text [not null, note: 'LGPD: narrative about a child; not PEI/AEE or a grade scale']
  status varchar [not null, default: 'draft', note: 'draft | published; one-way transition']
  published_at timestamp
  discarded_at timestamp [note: 'Drafts only; published rows are retained and corrected by a new report']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, student_id, created_at)
    (school_id, status)
  }
}

Table lesson_plans {
  id integer [primary key, increment]
  school_id integer [not null]
  class_discipline_id integer [not null]
  date date [not null]
  duration varchar [note: 'Free text, e.g. "50 minutos" — not a structured numeric/unit pair (BR-LP07 [product decision])']
  unit_stage varchar
  topic varchar
  general_objective text
  specific_objectives text
  bncc_competencies text [note: 'Free text, not validated against a catalog — no BNCC code catalog exists yet (BR-LP07 [product decision])']
  other_competencies text
  resources_materials text
  assessment_types varchar[] [not null, default: '{}', note: 'Allowed values enforced at the model level: diagnostic | formative | summative']
  assessment_formats varchar[] [not null, default: '{}', note: 'Allowed values enforced at the model level: observation | exercises | participation | written_production | oral_presentation | practical_activity | test']
  created_at timestamp
  updated_at timestamp

  indexes {
    (class_discipline_id, date) [unique, note: 'One plan per class_discipline/day (BR-LP04) — submitting again updates the row in place']
  }

  Note: 'Teacher plano de aula (BC10). All BR-LP07 template fields are optional — only class_discipline_id/date (which resolve professor/disciplina/turma/data) are required to save a plan. No status, no submission/approval workflow in this version (BR-LP05).'
}

Table school_instructional_days {
  id integer [primary key, increment]
  school_id integer [not null]
  school_year_id integer [not null]
  date date [not null]
  instructional boolean [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_year_id, date) [unique, note: 'One explicit instructional/non-instructional mark per calendar day per school year']
  }

  Note: 'BR-SY10 (school-year.md) — which calendar days are instructional, marked explicitly day by day by an admin (not derived from school_holidays by exclusion). A date with no row here is "undecided" and is treated as non-instructional by consumers (e.g. lesson_plans BR-LP03) — never guessed as instructional.'
}

Table incident_types {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null]
  category varchar [not null, note: 'disciplinary | pastoral | health (BR-IN01)']
  severity varchar [note: 'School-configurable free label (e.g. low/medium/high); no fixed catalog mandated by BR-IN01']
  default_visibility varchar [not null, default: 'staff_only', note: 'staff_only | guardian | guardian_on_publish — BR-IN02 forces staff_only at creation time for category=health regardless of this default']
  is_system boolean [not null, default: false, note: 'Seeded default row (system_key present) vs a school-authored custom type']
  system_key varchar [note: 'Stable lookup for a seeded default, e.g. guardian_meeting ("Reunião com os pais" — BC7 product ask). Null for custom types, mirrors school_role_templates.system_key']
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name) [unique, note: 'WHERE discarded_at IS NULL']
    (school_id, system_key) [unique, note: 'WHERE system_key IS NOT NULL AND discarded_at IS NULL']
  }

  Note: 'School-configurable incident type catalog (BR-IN01). Full CRUD management UI is deferred (docs/open-questions.md) — MVP ships one seeded system row per school ("Reunião com os pais", category pastoral) provisioned lazily on first incident creation, plus whatever a school adds through data/console until a management UI exists.'
}

Table incidents {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  incident_type_id integer [not null]
  reported_by_membership_id integer [not null]
  category varchar [not null, note: 'Snapshotted from incident_type.category at creation — stable even if the type catalog row changes later']
  severity varchar [note: 'Snapshotted from incident_type.severity at creation']
  visibility varchar [not null, note: 'staff_only | guardian | guardian_on_publish (BR-IN02)']
  status varchar [not null, default: 'pending_approval', note: 'pending_approval | approved | archived — BR-IN08 gate; archived is the only "delete" (BR-IN05), no endpoint ships yet']
  description text [note: 'LGPD: may contain health/sensitive data per category — see BR-IN07']
  guardian_points_raised text [note: '"Pontos trazidos pelos pais" — structured body field for the guardian-meeting incident type. LGPD: may contain sensitive family/health content']
  school_response text [note: '"Respostas da escola" — structured body field paired with guardian_points_raised. LGPD: may contain sensitive content']
  published_at timestamp [note: 'Guardian-facing publish moment (UC-IN02). Set immediately at creation for visibility=guardian; set by POST .../publish for guardian_on_publish; never set for staff_only']
  coordination_approved_at timestamp [note: 'BR-IN08 slot 1 of 2 — filled only by a membership whose role_template.system_key == "coordination"']
  coordination_approved_by_membership_id integer
  director_approved_at timestamp [note: 'BR-IN08 slot 2 of 2 — filled only by a membership whose role_template.system_key == "director"']
  director_approved_by_membership_id integer
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, student_id, created_at)
    (school_id, status)
    (incident_type_id)
  }

  Note: 'Occurrence record (BC7, product label "Ata"). No discarded_at — BR-IN05 "no hard delete" is expressed entirely through status (archived), not Discard. No occurred_on: UC-IN01 lists no distinct "when it happened" input, so the record date is created_at; a separate event-date field is an open item (docs/open-questions.md), not guessed into the schema. Attachments use has_many_attached :attachments directly on the model (Active Storage, same pattern as student_health_records.document and authorized_pickups.photo) — no separate incident_attachments table, since Active Storage already is this repo\'s one attachment mechanism.'
}

Table incident_guardians {
  id integer [primary key, increment]
  incident_id integer [not null]
  guardian_id integer [note: 'Nullable: a later guardian deletion nullifies rather than cascades, so the historical ata row survives (BR-IN11)']
  name varchar [not null, note: 'Denormalized snapshot of guardian.name at save time — does not follow later changes to the guardian or to the student\'s student_guardians links (BR-IN11)']
  relationship varchar [not null, note: 'Denormalized snapshot of student_guardians.relationship at save time — same non-live note as name (BR-IN11)']
  created_at timestamp
  updated_at timestamp

  indexes {
    (incident_id)
  }

  Note: 'BR-IN11 snapshot of the guardians recorded on an incident ("ata") at save time — one row per guardian. Distinct from the live student_guardians association: editing or removing a student_guardians link later does not change an already-saved incident_guardians row, since the ata is a historical record, not a derived view.'
}

// --- Documents & archive (008) ---

Table archive_document_types {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null]
  requires_review boolean [not null, default: false]
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name) [unique, note: 'WHERE discarded_at IS NULL']
  }
}

Table archive_documents {
  id integer [primary key, increment]
  school_id integer [not null]
  student_id integer [not null]
  school_year_id integer
  archive_document_type_id integer [not null]
  visibility varchar [not null, default: 'staff_only', note: 'staff_only | guardian']
  review_status varchar [not null, default: 'approved', note: 'pending | approved | rejected']
  uploaded_by_id integer
  legacy_fintech_kyc boolean [not null, default: false]
  discarded_at timestamp
  discarded_by_id integer
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, student_id)
    (school_id, review_status)
  }
}

Table document_signatories {
  id integer [primary key, increment]
  school_id integer [not null]
  role_label varchar [not null, note: 'E.g. Secretaria, Direção']
  name varchar [not null]
  title varchar
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table guardian_requests {
  id integer [primary key, increment]
  school_id integer [not null]
  guardian_id integer [not null]
  student_id integer [not null]
  kind varchar [not null, note: 'declaration | second_call']
  status varchar [not null, default: 'pending', note: 'pending | in_progress | fulfilled | rejected']
  details text [note: 'Nullable in shipped schema although application validates presence; null:false hardening requires a follow-up safe migration. LGPD: family request content']
  subject_id integer [note: 'Optional second-call subject FK; must share school_id. Cleared for declaration by shipped create service']
  reference_date date [note: 'Second-call request only']
  resolution_note text [note: 'Required by shipped resolve service when status = rejected; optional when fulfilled']
  resolved_by_id integer
  resolved_at timestamp
  requested_by_id integer
  discarded_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, status, created_at)
    (guardian_id, created_at)
  }
  Note: 'Shipped nullable-details mismatch is explicit; DB hardening is not yet implemented.'
}

// --- Relationships ---

Ref: schools.school_group_id > school_groups.id
Ref: schools.discarded_by_id > users.id

Ref: platform_plan_provider_prices.platform_plan_id > platform_plans.id
Ref: platform_subscriptions.school_id > schools.id
Ref: platform_subscriptions.platform_plan_id > platform_plans.id
Ref: platform_invoices.school_id > schools.id
Ref: platform_invoices.platform_subscription_id > platform_subscriptions.id
Ref: platform_impersonation_sessions.operator_user_id > users.id
Ref: platform_impersonation_sessions.target_user_id > users.id
Ref: platform_impersonation_sessions.school_id > schools.id
Ref: platform_impersonation_sessions.target_membership_id > memberships.id

Ref: memberships.user_id > users.id
Ref: memberships.school_id > schools.id
Ref: memberships.suspended_by_id > users.id

Ref: segments.school_id > schools.id
Ref: school_role_templates.school_id > schools.id
Ref: role_template_permissions.role_template_id > school_role_templates.id
Ref: role_template_permissions.school_id > schools.id
Ref: staff_profiles.membership_id > memberships.id
Ref: staff_profiles.school_id > schools.id
Ref: staff_profiles.role_template_id > school_role_templates.id
Ref: staff_profiles.segment_id > segments.id
Ref: membership_permissions.membership_id > memberships.id
Ref: membership_permissions.school_id > schools.id

Ref: membership_invite_tokens.membership_id > memberships.id
Ref: membership_invite_tokens.school_id > schools.id
Ref: membership_invite_tokens.created_by_id > users.id
Ref: provisioning_imports.school_id > schools.id
Ref: provisioning_imports.uploaded_by_id > users.id

Ref: school_years.school_id > schools.id
Ref: academic_periods.school_year_id > school_years.id
Ref: academic_periods.school_id > schools.id
Ref: school_holidays.school_id > schools.id
Ref: school_holidays.school_year_id > school_years.id
Ref: school_instructional_days.school_id > schools.id
Ref: school_instructional_days.school_year_id > school_years.id
Ref: calendar_events.school_id > schools.id
Ref: calendar_events.school_year_id > school_years.id
Ref: calendar_events.user_id > users.id

Ref: classes.school_id > schools.id
Ref: classes.school_year_id > school_years.id
Ref: classes.segment_id > segments.id
Ref: classes.parent_class_id > classes.id
Ref: class_assignments.school_id > schools.id
Ref: class_assignments.class_id > classes.id
