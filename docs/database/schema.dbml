// --- Change auditing (audited gem) ---
// Managed by gem migration — not a domain entity. See docs/guidelines/web/auditing.md.
// associated_* links audits to school for tenant-scoped queries.

Table audits {
  id integer [primary key, increment]
  auditable_id integer
  auditable_type varchar
  associated_id integer [note: 'school_id when using SchoolAuditable']
  associated_type varchar [note: 'School when using SchoolAuditable']
  user_id integer [note: 'users.id — actor; nullable for system jobs']
  user_type varchar [note: 'User']
  username varchar
  action varchar [note: 'create | update | destroy']
  audited_changes jsonb [note: 'Changed attributes — may contain PII; retention TBD']
  version integer [default: 0]
  comment varchar
  remote_address varchar
  request_uuid varchar
  created_at timestamp

  indexes {
    (auditable_type, auditable_id, version)
    (associated_type, associated_id)
    (user_id, user_type)
    request_uuid
    created_at
  }
}

