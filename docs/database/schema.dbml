// School Lab — executable schema (DBML)
// Auth: Devise (web session) + refresh_tokens (API JWT)
// Narrative DSL: docs/modeling/001-fintech-first.md, 003-identity-permissions.md, 004-school-onboarding.md
//
// Soft delete: Discard gem — default column discarded_at (nullable timestamp).
//   kept: discarded_at IS NULL — visible in app queries (Model.kept / default_scope).
//   discarded: set via discard — hidden; FKs and audit history preserved.
// Hard delete: scheduled job removes rows past retention (discarded_at + entity window).
//   Financial/audit tables may skip Discard and purge only by age (see per-table notes).
// Do not use Discard on ephemeral/ingress logs — use revoked_at, expires_at, or age-based purge.
//
// Indexes: unique, partial, and composite indexes are documented explicitly. Plain
//   single-column indexes that Rails creates automatically for `t.references` are
//   documented only on billing/financial tables, where query paths matter for review.
// Check constraints have no DBML representation — they are recorded in column notes
//   (non-negative money, allowed enum values, numeric ranges). Source: web/db/schema.rb.

Table school_groups {
  id integer [primary key, increment]
  name varchar [note: 'Network/holding — optional']
  headquarters_cnpj varchar
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp
}

Table schools {
  id integer [primary key, increment]
  school_group_id integer [note: 'Nullable — only when part of a network']
  name varchar [note: 'E.g. Example School — Downtown Unit']
  cnpj varchar
  address varchar
  saas_plan varchar
  onboarding_status varchar [not null, default: 'pending_handoff', note: 'provisioning | pending_handoff | active — see 004-school-onboarding.md']
  onboarding_mode varchar [not null, note: 'self_serve | white_glove — set at create; immutable after active']
  billing_waived_at timestamp [note: 'Handoff when billing setup skipped']
  segments_skipped_at timestamp [note: 'Handoff when segments deferred']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp
}

// --- Identity (Devise) ---

Table users {
  id integer [primary key, increment]
  email varchar [not null, default: '', note: 'LGPD: personal data — partial unique WHERE discarded_at IS NULL']
  encrypted_password varchar [not null, default: '']
  reset_password_token varchar [unique]
  reset_password_sent_at timestamp
  remember_created_at timestamp
  sign_in_count integer [not null, default: 0]
  current_sign_in_at timestamp
  last_sign_in_at timestamp
  current_sign_in_ip varchar
  last_sign_in_ip varchar
  confirmation_token varchar [unique]
  confirmed_at timestamp
  confirmation_sent_at timestamp
  unconfirmed_email varchar
  failed_attempts integer [not null, default: 0]
  unlock_token varchar [unique]
  locked_at timestamp [note: 'Devise lock — failed login attempts; distinct from status disabled']
  status varchar [not null, default: 'active', note: 'active | disabled — platform-wide auth block; revokes refresh_tokens']
  disabled_at timestamp [note: 'Set when status becomes disabled']
  disabled_by_id integer [note: 'Backoffice user who disabled; nullable for system/job']
  discarded_at timestamp [note: 'Discard gem — soft delete; purge after retention']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    email [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

Table memberships {
  id integer [primary key, increment]
  user_id integer [not null]
  school_id integer [note: 'Nullable for platform backoffice']
  role varchar [not null, note: 'backoffice | staff | teacher | guardian — school deprecated, migrate to staff (003)']
  status varchar [not null, default: 'active', note: 'active | invited | suspended — per-school only; global disable is users.status']
  platform_permissions jsonb [not null, default: '[]', note: 'Backoffice only — e.g. provision_school (004-school-onboarding.md)']
  suspended_at timestamp [note: 'Set when status becomes suspended']
  suspended_by_id integer [note: 'School admin who suspended; nullable for system/job']
  discarded_at timestamp [note: 'Discard — removes school link; distinct from suspended']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, school_id) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

Table refresh_tokens {
  id integer [primary key, increment]
  user_id integer [not null]
  token_digest varchar [not null, unique, note: 'Store hash only — never raw token']
  expires_at timestamp [not null]
  revoked_at timestamp [note: 'No Discard — revoke + purge after expires_at']
  created_at timestamp
}

Table device_tokens {
  id integer [primary key, increment]
  user_id integer [not null]
  token varchar [not null, note: 'FCM registration token']
  platform varchar [not null, note: 'ios | android | web']
  discarded_at timestamp [note: 'Discard — unregister on logout or token rotation']
  created_at timestamp
  updated_at timestamp

  indexes {
    token [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

// --- Identity: permissions (003) ---

Table school_role_templates {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null, note: 'UI label — e.g. Direção, Recepcionista']
  system_key varchar [note: 'director | secretary | coordination | teacher — null for custom templates']
  is_system boolean [not null, default: false, note: 'Provisioned defaults — not deletable']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, system_key) [note: 'DB migration: UNIQUE WHERE system_key IS NOT NULL AND discarded_at IS NULL']
    school_id
  }
}

Table role_template_permissions {
  id integer [primary key, increment]
  role_template_id integer [not null]
  school_id integer [not null, note: 'Denormalized for tenant scopes']
  permission_key varchar [not null, note: 'Fixed enum in code — see permissions PRD']
  scope_kind varchar [not null, default: 'full', note: 'full | segment | partial']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    (role_template_id, permission_key) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, permission_key)
  }
}

Table segments {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar [not null, note: 'E.g. Early childhood, Elementary — MVP minimum']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, name) [note: 'DB migration: UNIQUE WHERE discarded_at IS NULL per school']
  }
}

Table staff_profiles {
  id integer [primary key, increment]
  membership_id integer [not null, note: 'One profile per staff or teacher membership']
  school_id integer [not null, note: 'Denormalized for tenant scopes and owner unique index']
  role_template_id integer [not null, note: 'FK school_role_templates — pointer; edits propagate at runtime']
  is_owner boolean [not null, default: false, note: 'At most one true per school among kept profiles']
  segment_id integer [note: 'Nullable — scope for partial permissions']
  display_title varchar [note: 'Cosmetic UI label — LGPD: may contain personal name']
  also_teaches boolean [not null, default: false, note: 'Coordination template: enables teach permission']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp

  indexes {
    membership_id [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, is_owner) [note: 'Partial unique WHERE is_owner = true AND discarded_at IS NULL — one owner per school']
  }
}

Table membership_permissions {
  id integer [primary key, increment]
  membership_id integer [not null]
  school_id integer [not null]
  permission_key varchar [not null, note: 'Fixed enum in code — see permissions PRD']
  effect varchar [not null, default: 'grant', note: 'grant | deny — overrides only, not template snapshot']
  discarded_at timestamp [note: 'Discard on revoke']
  created_at timestamp
  updated_at timestamp

  indexes {
    (membership_id, permission_key) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, permission_key)
  }
}

// --- School domain ---

Table guardians {
  id integer [primary key, increment]
  school_id integer [not null]
  user_id integer [note: 'Set when guardian creates account or accepts invite']
  name varchar
  cpf varchar [note: 'LGPD: sensitive personal data']
  email varchar [note: 'LGPD: contact email; may match users.email after signup']
  phone varchar [note: 'LGPD: personal data']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp
}

Table students {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar
  birth_date date [note: 'LGPD: child data — guardian consent required']
  status varchar [not null, default: 'active', note: 'Enrollment state — e.g. active | transferred; distinct from discarded_at']
  discarded_at timestamp [note: 'Discard gem — removed from active school records']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, status)
  }
}

Table teachers {
  id integer [primary key, increment]
  school_id integer [not null]
  user_id integer [note: 'Set when teacher account is provisioned']
  name varchar
  status varchar [default: 'active']
  discarded_at timestamp [note: 'Discard gem — null = kept']
  created_at timestamp
  updated_at timestamp
  Note: 'PLANNED — not migrated. No teachers table exists in web/db/schema.rb; the academic phase creates it. Teacher role is carried by memberships.role today.'
}

Table student_guardians {
  id integer [primary key, increment]
  guardian_id integer [not null]
  student_id integer [not null]
  school_id integer [not null]
  financial_percentage decimal(5,2) [note: 'Check constraint: NULL or between 0 and 100']
  primary_guardian boolean
  discarded_at timestamp [note: 'Discard gem — unlink guardian↔student']
  created_at timestamp
  updated_at timestamp

  indexes {
    (guardian_id, student_id) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
  }
}

// --- Billing ---

Table billing_plans {
  id integer [primary key, increment]
  school_id integer [not null]
  name varchar
  plan_type varchar [note: 'tuition | enrollment | fee']
  base_amount_cents integer [note: 'Integer cents; nullable — optional template default when every contract carries negotiated_amount_cents. Charge generation resolves negotiated_amount_cents → base_amount_cents → 0. Check constraint: base_amount_cents IS NULL OR base_amount_cents >= 0.']
  discarded_at timestamp [note: 'Discard gem — archived plan']
  created_at timestamp
  updated_at timestamp
}

Table school_payment_providers {
  id integer [primary key, increment]
  school_id integer [not null]
  instrument varchar [not null, note: 'bank_slip — card added later without migration. Check constraint: instrument = bank_slip.']
  provider varchar [not null, note: 'cora | fake — model validates inclusion in the registered adapters']
  active boolean [not null, default: true]
  settings jsonb [not null, default: '{}']
  client_id varchar [note: 'Required for cora (model validation); nullable in DB because fake needs no credentials']
  certificate_pem text [note: 'Active Record Encryption — non-deterministic. Required for cora (model validation)']
  private_key_pem text [note: 'Active Record Encryption — non-deterministic. Required for cora (model validation)']
  certificate_fingerprint varchar [note: 'SHA-256 of cert DER — clear text']
  certificate_expires_at timestamp
  uploaded_at timestamp
  uploaded_by_id integer
  webhook_endpoint_token varchar [not null, note: 'Secret URL segment for unsigned provider notifications; rotatable']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, instrument) [unique, note: 'Partial: WHERE active = true — one active configuration per school and instrument']
    webhook_endpoint_token [unique]
  }
}

Table school_billing_settings {
  id integer [primary key, increment]
  school_id integer [not null, unique]
  overdue_grace_days integer [not null, default: 3, note: '0–30 days before a charge is marked overdue. Check constraint: BETWEEN 0 AND 30.']
  service_description varchar(100) [note: 'Guardian-facing boleto line; default from i18n']
  notification_schedule jsonb [not null, default: '{}', note: 'Future platform email régua rules relative to due date — not consumed in MVP']
  interest_rate_percent decimal(5,2) [note: 'Monthly mora interest % sent to Cora payment_terms.interest.rate. No default; issuance blocked when NULL. Fine/discount fields phase 2.']
  created_at timestamp
  updated_at timestamp
}

Table contracts {
  id integer [primary key, increment]
  student_id integer [not null]
  school_id integer [not null]
  billing_plan_id integer [not null]
  negotiated_amount_cents integer [note: 'Monetary amounts stored as integer cents. Check constraint: negotiated_amount_cents IS NULL OR negotiated_amount_cents >= 0.']
  due_day integer [note: '1–28']
  starts_on date
  ends_on date
  status varchar [not null, default: 'active', note: 'active | suspended | ended']
  discarded_at timestamp [note: 'Discard gem — distinct from status ended']
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, status)
  }
}

Table charges {
  id integer [primary key, increment]
  contract_id integer [not null]
  school_id integer [not null]
  guardian_id integer [not null, note: 'Financially responsible guardian for this charge']
  billing_period date [not null, note: 'First day of billing month — e.g. 2026-08-01']
  original_amount_cents integer [not null, note: 'Monetary amounts stored as integer cents. Check constraint: >= 0.']
  discount_amount_cents integer [not null, default: 0, note: 'Check constraint: >= 0']
  late_fee_amount_cents integer [not null, default: 0, note: 'Check constraint: >= 0. Stays 0 today — Billing::LateFeeCalculator is a zero-returning placeholder until the fee rule is decided.']
  total_amount_cents integer [not null, note: 'original - discount + late fee. Check constraint: >= 0.']
  due_date date
  status varchar [not null, default: 'pending', note: 'pending | paid | overdue | cancelled — business state; discard for erroneous removal']
  provider_invoice_id varchar [note: 'Cached active provider invoice id — canonical history in charge_issuances']
  boleto_url varchar [note: 'Cached last-issued boleto URL for guardian display']
  pix_copy_paste text [note: 'Cached last-issued Pix EMV for guardian display']
  paid_at timestamp [note: 'AASM timestamp — set on pay transition']
  overdue_at timestamp [note: 'AASM timestamp — set on mark_overdue transition']
  cancelled_at timestamp [note: 'AASM timestamp — set on cancel transition']
  discarded_at timestamp [note: 'Discard gem — erroneous/duplicate charge removal']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp

  indexes {
    (contract_id, billing_period) [unique, note: 'DB migration: UNIQUE WHERE discarded_at IS NULL']
    (school_id, status)
    (school_id, due_date)
    provider_invoice_id [unique, note: 'WHERE provider_invoice_id IS NOT NULL']
    contract_id
    guardian_id
    school_id
    discarded_by_id
  }
}

Table collection_reminder_deliveries {
  id integer [primary key, increment]
  school_id integer [not null]
  charge_id integer [not null]
  rule_key varchar [not null, note: 'e.g. days_after_due:3, overdue_transition']
  sent_on date [not null, note: 'School timezone date — deduplicates same-day reminders per rule']
  created_at timestamp
  updated_at timestamp

  indexes {
    (charge_id, rule_key, sent_on) [unique]
    (school_id, sent_on)
    school_id
    charge_id
  }
}

Table charge_issuances {
  id integer [primary key, increment]
  charge_id integer [not null]
  school_id integer [not null]
  provider varchar [not null, note: 'Payment provider identifier — e.g. cora, fake; not a generic PSP label']
  provider_invoice_id varchar [note: 'Provider invoice id; partial unique when present']
  idempotency_key varchar [not null, note: 'Persisted before HTTP — retry-safe issuance']
  status varchar [not null, default: 'pending', note: 'pending | issued | failed | cancelled']
  amount_cents integer [not null, note: 'Snapshot of charge total at issuance time. Check constraint: >= 0.']
  due_date date [not null, note: 'Snapshot of charge due date at issuance time']
  boleto_url varchar
  digitable_line varchar
  barcode varchar
  our_number varchar
  pix_emv text
  issued_at timestamp
  cancelled_at timestamp
  last_error text [note: 'Provider error on failed transition']
  created_at timestamp
  updated_at timestamp
  Note: 'One row per bank invoice; immutable financial record — cancel via status, not Discard'

  indexes {
    idempotency_key [unique]
    provider_invoice_id [unique, note: 'WHERE provider_invoice_id IS NOT NULL']
    (charge_id, status)
    charge_id
    school_id
  }
}

Table applied_discounts {
  id integer [primary key, increment]
  charge_id integer [not null]
  school_id integer [not null]
  discount_type varchar
  amount_cents integer [note: 'Integer cents; nullable until discount application ships. Fixed-amount discount lines must set amount_cents; percentage discounts may leave NULL until a rate column exists. Check constraint: amount_cents IS NULL OR amount_cents >= 0.']
  discarded_at timestamp [note: 'Discard gem — discount line removed']
  created_at timestamp
  updated_at timestamp

  indexes {
    charge_id
    school_id
  }
}

Table payments {
  id integer [primary key, increment]
  charge_id integer [not null]
  school_id integer [not null]
  paid_amount_cents integer [not null, note: 'Monetary amounts stored as integer cents. Check constraint: >= 0.']
  fine_amount_cents integer [not null, default: 0, note: 'Bank-reported fine component at settlement. Check constraint: >= 0.']
  interest_amount_cents integer [not null, default: 0, note: 'Bank-reported interest component at settlement. Check constraint: >= 0.']
  payment_method varchar [note: 'boleto | pix | card']
  provider_payment_id varchar [note: 'Provider settlement id; partial unique when present']
  paid_at timestamp
  status varchar [not null, default: 'confirmed']
  created_at timestamp
  updated_at timestamp
  Note: 'No Discard — immutable financial record; hard delete only after legal retention'

  indexes {
    provider_payment_id [unique, note: 'WHERE provider_payment_id IS NOT NULL']
    charge_id
    school_id
  }
}

Table webhook_events {
  id integer [primary key, increment]
  school_id integer [note: 'Tenant that received the notification']
  provider varchar [not null, note: 'cora | fake']
  provider_event_id varchar [not null, note: 'Idempotency key from provider — unique per provider']
  event_type varchar
  provider_resource_id varchar [note: 'Normalized invoice/resource id from the notification']
  payload text [note: 'Raw notification body when the provider sends one; NULL for Cora, whose notification carries only event headers']
  processing_error text [note: 'Mismatch or permanent failure details — no PII']
  observed_status varchar [note: 'Invoice status observed during reconciliation']
  processed_at timestamp [note: 'Set when reconciliation finishes; drives the purge window']
  created_at timestamp
  updated_at timestamp
  Note: 'No Discard — ingress audit log. Processed rows are purged 180 days after processed_at (Billing::PurgeWebhookEventsJob; window from config.x.billing.webhook_events_retention_days, override via WEBHOOK_EVENTS_RETENTION_DAYS). Unprocessed rows (processed_at IS NULL) are never purged — they represent unreconciled money movement.'

  indexes {
    (provider, provider_event_id) [unique]
    school_id
  }
}

// --- Documents (MVP: enrollment/KYC docs — not full digital archive) ---

Table documents {
  id integer [primary key, increment]
  school_id integer [not null, note: 'Per-school isolation — required even for polymorphic parent']
  documentable_type varchar [not null, note: 'School | Guardian | Student — Teacher deferred to academic phase']
  documentable_id integer [not null]
  document_type varchar
  status varchar [not null, default: 'pending', note: 'pending | approved | rejected']
  rejection_reason varchar
  uploaded_by_id integer
  reviewed_at timestamp
  discarded_at timestamp [note: 'Discard gem — removed from active archive']
  discarded_by_id integer [note: 'users.id — who discarded; nullable for system/job']
  created_at timestamp
  updated_at timestamp

  indexes {
    (documentable_type, documentable_id)
    (school_id, status)
  }
}

// --- Onboarding (004) ---

Table membership_invite_tokens {
  id integer [primary key, increment]
  membership_id integer [not null]
  school_id integer [not null]
  token_digest varchar [not null, unique, note: 'SHA-256 of opaque token — never store raw token']
  expires_at timestamp [not null, note: 'Default created_at + 7 days']
  used_at timestamp [note: 'Set on successful POST /auth/invite/accept']
  created_by_id integer [note: 'users.id — inviter; nullable for system']
  created_at timestamp
  updated_at timestamp

  indexes {
    membership_id [note: 'At most one unused token per membership — invalidate on resend; partial unique WHERE used_at IS NULL TBD']
    (school_id, expires_at)
  }
}

Table provisioning_imports {
  id integer [primary key, increment]
  school_id integer [not null]
  uploaded_by_id integer [not null, note: 'users.id — backoffice actor']
  status varchar [not null, default: 'previewed', note: 'previewed | committed | failed']
  row_count integer
  error_report jsonb [note: 'Validation errors from dry_run — LGPD: may contain PII']
  committed_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (school_id, created_at)
  }
}

// --- Relationships ---

Ref: schools.school_group_id > school_groups.id
Ref: schools.discarded_by_id > users.id

Ref: memberships.user_id > users.id
Ref: memberships.school_id > schools.id
Ref: memberships.suspended_by_id > users.id

Ref: segments.school_id > schools.id
Ref: school_role_templates.school_id > schools.id
Ref: role_template_permissions.role_template_id > school_role_templates.id
Ref: role_template_permissions.school_id > schools.id
Ref: staff_profiles.membership_id > memberships.id
Ref: staff_profiles.school_id > schools.id
Ref: staff_profiles.role_template_id > school_role_templates.id
Ref: staff_profiles.segment_id > segments.id
Ref: membership_permissions.membership_id > memberships.id
Ref: membership_permissions.school_id > schools.id

Ref: membership_invite_tokens.membership_id > memberships.id
Ref: membership_invite_tokens.school_id > schools.id
Ref: membership_invite_tokens.created_by_id > users.id
Ref: provisioning_imports.school_id > schools.id
Ref: provisioning_imports.uploaded_by_id > users.id
Ref: refresh_tokens.user_id > users.id
Ref: device_tokens.user_id > users.id
Ref: users.disabled_by_id > users.id

Ref: guardians.school_id > schools.id
Ref: guardians.user_id > users.id
Ref: guardians.discarded_by_id > users.id
Ref: students.school_id > schools.id
Ref: students.discarded_by_id > users.id
Ref: teachers.school_id > schools.id
Ref: teachers.user_id > users.id
Ref: billing_plans.school_id > schools.id
Ref: school_payment_providers.school_id > schools.id
Ref: school_payment_providers.uploaded_by_id > users.id
Ref: school_billing_settings.school_id > schools.id

Ref: student_guardians.guardian_id > guardians.id
Ref: student_guardians.student_id > students.id
Ref: student_guardians.school_id > schools.id

Ref: contracts.student_id > students.id
Ref: contracts.billing_plan_id > billing_plans.id
Ref: contracts.school_id > schools.id

Ref: charges.contract_id > contracts.id
Ref: charges.guardian_id > guardians.id
Ref: charges.discarded_by_id > users.id
Ref: charges.school_id > schools.id

Ref: collection_reminder_deliveries.school_id > schools.id
Ref: collection_reminder_deliveries.charge_id > charges.id

Ref: charge_issuances.charge_id > charges.id
Ref: charge_issuances.school_id > schools.id

Ref: applied_discounts.charge_id > charges.id
Ref: applied_discounts.school_id > schools.id
Ref: payments.charge_id > charges.id
Ref: payments.school_id > schools.id

Ref: documents.school_id > schools.id
Ref: documents.uploaded_by_id > users.id
Ref: documents.discarded_by_id > users.id

// --- Change auditing (audited gem) ---
// Managed by gem migration — not a domain entity. See docs/guidelines/web/auditing.md.
// associated_* links audits to school for tenant-scoped queries.

Table audits {
  id integer [primary key, increment]
  auditable_id integer
  auditable_type varchar
  associated_id integer [note: 'school_id when using SchoolAuditable']
  associated_type varchar [note: 'School when using SchoolAuditable']
  user_id integer [note: 'users.id — actor; nullable for system jobs']
  user_type varchar [note: 'User']
  username varchar
  action varchar [note: 'create | update | destroy']
  audited_changes jsonb [note: 'Changed attributes — may contain PII; retention TBD']
  version integer [default: 0]
  comment varchar
  remote_address varchar
  request_uuid varchar
  created_at timestamp

  indexes {
    (auditable_type, auditable_id, version)
    (associated_type, associated_id)
    (user_id, user_type)
    request_uuid
    created_at
  }
}

// --- Sample data ---

Records school_groups(id, name) {
  0, 'Example School'
}

Records schools(id, school_group_id, name, onboarding_status, onboarding_mode) {
  0, 0, 'Example School — Downtown Unit', 'active', 'self_serve'
