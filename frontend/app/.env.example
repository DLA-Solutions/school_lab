# Base URL of the School Lab API (web/). Defaults to http://localhost:3000 when unset.
VITE_API_BASE_URL=http://localhost:3000

# Build/deploy only — leave unset for local dev (base stays /).
# VITE_BASE_PATH=/app/
# VITE_API_BASE_URL=https://staging.scholarpremium.com.br
# For same-origin production builds, leave VITE_API_BASE_URL empty so requests use /api/...

# Google OAuth Web client ID (Google Cloud Console → OAuth 2.0 → Web application).
# Authorized JavaScript origins must include http://localhost:5173 and your deploy origins.
# Must match GOOGLE_OAUTH_CLIENT_ID on the API (web/.env).
VITE_GOOGLE_OAUTH_CLIENT_ID=
