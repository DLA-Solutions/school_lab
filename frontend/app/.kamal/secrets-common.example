# Copy to .kamal/secrets-common. Shared by every destination.
# Values are pulled from the environment or from files — never enter raw credentials here.
#
# Required on the deploy machine:
#   KAMAL_REGISTRY_PASSWORD  GitHub personal access token with write:packages
#
# Do not reuse a plain GITHUB_TOKEN here: the token that authenticates gh and the
# GitHub API usually lacks the packages scopes, and GHCR rejects it with a 401 that
# reads like a wrong password.

# Reads ~/.config/gh/hosts.yml — no network call, and each developer gets their own login.
KAMAL_REGISTRY_USERNAME=$(gh config get -h github.com user)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Google OAuth Web client ID — public in the SPA bundle; must match web GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=$GOOGLE_OAUTH_CLIENT_ID
