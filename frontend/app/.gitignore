# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
build
*.local

# TypeScript build output. `tsc -b` is type-check only (see tsconfig.json), but a stray
# vite.config.js would silently shadow vite.config.ts for Vite, Vitest and Ladle.
*.tsbuildinfo
vite*.config.js
vite*.config.d.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Kamal secrets — only the .example templates are versioned.
/.kamal/secrets*
!/.kamal/secrets*.example
