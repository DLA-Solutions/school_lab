{
  // Solution-style root, mirroring frontend/: it owns no files, it only builds the two real
  // projects, so `tsc -b` type-checks the catalog source and its Vite config in one command.
  // TypeScript rejects `noEmit` on a project referenced from a project that has files of its own,
  // which is why the source moved out of here into tsconfig.app.json.
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
