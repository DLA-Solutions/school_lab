{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // vite.config.ts is read by Vite, never imported, so this project is a type-check only pass.
    // Emitting here would drop a vite.config.js next to the source, and Vite resolves that
    // compiled artifact ahead of vite.config.ts.
    "noEmit": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
