    "@mui/x-data-grid": "^8.23.0",
    "@mui/x-date-pickers": "^8.23.0",
    "@school-lab/design-tokens": "file:../packages/design-tokens",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.11.0",
    "simplebar": "^6.3.3"
