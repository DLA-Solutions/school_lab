#!/usr/bin/env bash
# Pre-push — full local CI for surfaces changed in commits being pushed.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
ran=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  ran=1
  printf '\n\033[1m[pre-push]\033[0m Running bin/ci for %s\n' "$local_ref"
  if [ "$remote_sha" = "$ZERO" ]; then
    "$REPO_ROOT/bin/ci" --base origin/main || exit 1
  else
    "$REPO_ROOT/bin/ci" --since "$remote_sha" || exit 1
  fi
done

[ "$ran" -eq 0 ] && exit 0
