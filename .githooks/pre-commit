#!/usr/bin/env bash
# Pre-commit — quick lint on staged files per surface (overcommit-style, fast).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=bin/lib/ci-surfaces.sh
source "$REPO_ROOT/bin/lib/ci-surfaces.sh"

CHANGED="$(ci_changed_files "$REPO_ROOT" "" staged)"
[ -z "$CHANGED" ] && exit 0

SURFACES="$(ci_surfaces_from_changed "$CHANGED")"

if printf '%s\n' "$SURFACES" | grep -qx web; then
  RUBY_TARGETS=""
  while IFS= read -r f; do
    case "$f" in
      web/*.rb) RUBY_TARGETS="$RUBY_TARGETS ${f#web/}" ;;
    esac
  done <<EOF
$CHANGED
EOF
  if [ -n "${RUBY_TARGETS// }" ]; then
    printf '\n\033[1m[pre-commit]\033[0m RuboCop — staged web/*.rb\n'
    cd "$REPO_ROOT/web"
    # shellcheck disable=SC2086
    bin/rubocop -f github --force-exclusion $RUBY_TARGETS
  fi
fi

if printf '%s\n' "$SURFACES" | grep -qx frontend; then
  if printf '%s\n' "$CHANGED" | grep -qE '^frontend/app/|^packages/design-tokens/'; then
    printf '\n\033[1m[pre-commit]\033[0m ESLint — school SPA\n'
    cd "$REPO_ROOT/frontend/app"
    npm run lint
  fi
fi

if printf '%s\n' "$SURFACES" | grep -qx backoffice; then
  if printf '%s\n' "$CHANGED" | grep -qE '^frontend/backoffice/|^packages/design-tokens/'; then
    printf '\n\033[1m[pre-commit]\033[0m ESLint — backoffice SPA\n'
    cd "$REPO_ROOT/frontend/backoffice"
    npm run lint
  fi
fi
